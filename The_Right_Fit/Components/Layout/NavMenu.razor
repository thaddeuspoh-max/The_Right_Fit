@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager NavigationManager

<nav class="trf-topnav">

    <!-- Brand -->
    <a class="trf-brand" href="/">THE RIGHT FIT</a>

    <!-- Center links -->
    <div class="trf-topnav-links">
        <NavLink class="trf-toplink" href="/" Match="NavLinkMatch.All">Home</NavLink>

        <AuthorizeView Context="auth">
            <Authorized>

                <NavLink class="trf-toplink" href="workoutplans">Workout Plans</NavLink>
                <NavLink class="trf-toplink" href="exercises">Exercises</NavLink>
                <NavLink class="trf-toplink" href="workoutlogs">Workout Logs</NavLink>
                <NavLink class="trf-toplink" href="dietlogs">Diet Logs</NavLink>

                <!-- Admin only -->
                <AuthorizeView Roles="Administrator" Context="adminAuth">
                    <Authorized>
                        <NavLink class="trf-toplink" href="fooditems">Food Items</NavLink>
                    </Authorized>
                </AuthorizeView>

            </Authorized>
        </AuthorizeView>
    </div>

    <!-- Right auth section -->
    <div class="trf-topnav-auth">
        <AuthorizeView Context="auth">
            <Authorized>
                <NavLink class="trf-toplink trf-user" href="Account/Manage">
                    @auth.User.Identity?.Name
                </NavLink>

                <form action="/Account/Logout"
                      method="post"
                      class="trf-logout-form"
                      @formname="logoutForm">

                    <AntiforgeryToken />
                    <input type="hidden"
                           name="returnUrl"
                           value="@(NavigationManager.ToBaseRelativePath(NavigationManager.Uri) ?? "/")" />

                    <button type="submit" class="trf-topbtn">
                        Logout
                    </button>
                </form>
            </Authorized>

            <NotAuthorized>
                <NavLink class="trf-toplink" href="Account/Login">Login</NavLink>
                <NavLink class="trf-toplink trf-cta" href="Account/Register">Register</NavLink>
            </NotAuthorized>
        </AuthorizeView>
    </div>

</nav>
