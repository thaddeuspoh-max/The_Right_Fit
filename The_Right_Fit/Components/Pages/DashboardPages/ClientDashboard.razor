@page "/dashboard"
@rendermode InteractiveServer

@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using The_Right_Fit.Domain
@using Microsoft.AspNetCore.WebUtilities

@inject IDbContextFactory<The_Right_Fit.Data.The_Right_FitContext> DbFactory
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav

<PageTitle>Client Dashboard</PageTitle>

<div class="dash">

    <!-- Header -->
    <div class="dash-header">
        <div>
            <div class="dash-kicker">CLIENT DASHBOARD</div>
            <h1 class="dash-title">Welcome back 👋</h1>
            <p class="dash-sub">Here’s your overview for today.</p>
        </div>

        <div class="dash-header-actions">
            <NavLink class="dash-btn-link" href="/workoutlogs/create">
                <button type="button" class="dash-btn dash-btn-primary">
                    + Log Workout
                </button>
            </NavLink>

            <NavLink class="dash-btn-link" href="/dietlogs/create">
                <button type="button" class="dash-btn dash-btn-secondary">
                    + Log Meal
                </button>
            </NavLink>

            <button type="button" class="dash-btn" @onclick="Reload" disabled="@loading">
                @(loading ? "Refreshing..." : "Refresh")
            </button>
        </div>
    </div>

    @if (loading)
    {
        <div class="wp-loading">Loading dashboard…</div>
    }
    else if (!string.IsNullOrWhiteSpace(error))
    {
        <div class="wp-empty">
            <div class="wp-empty-title">Dashboard error</div>
            <div class="wp-empty-sub">@error</div>
        </div>
    }
    else
    {
        <!-- Stats row -->
        <div class="dash-stats">
            <div class="dash-stat">
                <div class="dash-stat-label">Streak</div>
                <div class="dash-stat-value">@($"{streakDays} days")</div>
                <div class="dash-stat-note">@streakNote</div>
            </div>

            <div class="dash-stat">
                <div class="dash-stat-label">Calories (Today)</div>
                <div class="dash-stat-value">@todayCaloriesText</div>
                <div class="dash-stat-note">@todayCaloriesNote</div>
            </div>

            <div class="dash-stat">
                <div class="dash-stat-label">Workouts</div>
                <div class="dash-stat-value">@($"{workoutsThisWeek} / week")</div>
                <div class="dash-stat-note">This week</div>
            </div>
        </div>

        <!-- Grid -->
        <div class="dash-grid">

            <!-- Today’s Plan -->
            <div class="dash-card">
                <div class="dash-card-head">
                    <div class="dash-h2">Today’s Plan</div>
                    <div class="dash-pill">@todayPlanTitle</div>
                </div>

                @if (todayPlanItems.Count == 0)
                {
                    <div class="dash-plan">
                        <div class="dash-plan-item">
                            <div class="dash-plan-title">No plan started</div>
                            <div class="dash-plan-meta">Go to Workout Plans and start one to see today’s exercises.</div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="dash-plan">
                        @foreach (var item in todayPlanItems)
                        {
                            <div class="dash-plan-item">
                                <div class="dash-plan-title">@item.Title</div>
                                <div class="dash-plan-meta">@item.Meta</div>
                            </div>
                        }
                    </div>
                }

                <div class="dash-card-actions">
                    <NavLink class="dash-btn-link" href="/workoutplans">
                        <button type="button" class="dash-btn">
                            View Workout Plans
                        </button>
                    </NavLink>
                </div>
            </div>

            <!-- Progress (week only) -->
            <div class="dash-card">
                <div class="dash-card-head">
                    <div class="dash-h2">Progress</div>
                </div>

                <div class="dash-progress-block">
                    <div class="dash-progress-row">
                        <div class="dash-progress-label">Workouts completed</div>
                        <div class="dash-progress-value">@($"{progressWorkoutsDone} / {progressWorkoutsGoal}")</div>
                    </div>
                    <div class="dash-bar">
                        <div class="dash-bar-fill" style="@($"width:{progressWorkoutsPct}%")"></div>
                    </div>
                </div>

                <div class="dash-progress-block">
                    <div class="dash-progress-row">
                        <div class="dash-progress-label">Calories</div>
                        <div class="dash-progress-value">@($"{todayCaloriesForBar} / {calorieGoal}")</div>
                    </div>
                    <div class="dash-bar">
                        <div class="dash-bar-fill" style="@($"width:{caloriePct}%")"></div>
                    </div>
                </div>
            </div>

            <!-- Recent Activity -->
            <div class="dash-card dash-span-2">
                <div class="dash-card-head">
                    <div class="dash-h2">Recent Activity</div>
                </div>

                @if (recent.Count == 0)
                {
                    <div class="dash-activity">
                        <div class="dash-activity-item">
                            <div class="dash-dot"></div>
                            <div>
                                <div class="dash-activity-title">No recent activity</div>
                                <div class="dash-activity-sub">Log a workout or meal to see it here.</div>
                            </div>
                            <div class="dash-activity-tag">New</div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="dash-activity">
                        @foreach (var a in recent)
                        {
                            <div class="dash-activity-item">
                                <div class="dash-dot" style="@a.DotStyle"></div>
                                <div>
                                    <div class="dash-activity-title">@a.Title</div>
                                    <div class="dash-activity-sub">@a.Subtitle</div>
                                </div>
                                <div class="dash-activity-tag" style="@a.TagStyle">@a.Tag</div>
                            </div>
                        }
                    </div>
                }
            </div>

        </div>
    }
</div>

@code {
    private bool loading = true;
    private string? error;

    private string? identityUserId;

    // Stats
    private int streakDays;
    private string streakNote = "Keep it going";
    private int workoutsThisWeek;

    // Calories (today)
    private int calorieGoal = 2100;
    private int todayCalories;
    private string todayCaloriesText = "—";
    private string todayCaloriesNote = "";

    // Progress (week only)
    private int progressWorkoutsDone;
    private int progressWorkoutsGoal = 5;
    private int progressWorkoutsPct;

    private int todayCaloriesForBar => Math.Max(0, todayCalories);
    private int caloriePct => Percent(todayCaloriesForBar, calorieGoal);

    // Today plan
    private int? selectedPlanId;
    private string todayPlanTitle = "Today";
    private List<PlanItem> todayPlanItems = new();

    // Recent activity
    private List<ActivityItem> recent = new();

    private record PlanItem(string Title, string Meta);

    private record ActivityItem(
        string Title,
        string Subtitle,
        string Tag,
        string DotStyle,
        string TagStyle
    );

    protected override async Task OnInitializedAsync()
        => await Load();

    private async Task Reload()
        => await Load();

    private async Task Load()
    {
        loading = true;
        error = null;

        try
        {
            var auth = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = auth.User;

            if (user.Identity?.IsAuthenticated != true)
            {
                Nav.NavigateTo("/Account/Login", true);
                return;
            }

            identityUserId = user.FindFirstValue(ClaimTypes.NameIdentifier);
            if (string.IsNullOrWhiteSpace(identityUserId))
            {
                error = "Cannot read your user id.";
                return;
            }

            using var db = DbFactory.CreateDbContext();

            // 1) read planId from URL (if they just clicked Start Plan)
            int? planIdFromUrl = null;
            var uri = Nav.ToAbsoluteUri(Nav.Uri);
            var query = QueryHelpers.ParseQuery(uri.Query);
            if (query.TryGetValue("planId", out var pidRaw) && int.TryParse(pidRaw.ToString(), out var pid))
                planIdFromUrl = pid;

            // 2) if URL has planId, save it as active (replaces previous)
            if (planIdFromUrl is not null)
            {
                await SaveActivePlan(db, planIdFromUrl.Value);
                selectedPlanId = planIdFromUrl.Value;

                // clean URL
                Nav.NavigateTo("/dashboard", replace: true);
            }
            else
            {
                // 3) otherwise always load active plan from DB
                selectedPlanId = await LoadActivePlan(db);
            }

            var today = DateTime.Today;
            var last30 = today.AddDays(-30);

            var workoutLogs = await db.WorkoutLog
                .AsNoTracking()
                .Where(x => x.OwnerIdentityUserId == identityUserId)
                .Where(x => x.WorkoutDateTime >= last30)
                .OrderByDescending(x => x.WorkoutDateTime)
                .ToListAsync();

            var weekStart = StartOfWeek(today, DayOfWeek.Monday);
            var weekEnd = weekStart.AddDays(7);

            workoutsThisWeek = workoutLogs.Count(x =>
                x.WorkoutDateTime >= weekStart && x.WorkoutDateTime < weekEnd);

            var dietLogs = await db.DietLog
                .AsNoTracking()
                .Where(x => x.OwnerIdentityUserId == identityUserId)
                .Where(x => x.LogDate >= last30)
                .OrderByDescending(x => x.LogDate)
                .ToListAsync();

            todayCalories = dietLogs
                .Where(x => x.LogDate.Date == today)
                .Sum(x => x.TotalCalories);

            todayCaloriesText = todayCalories > 0 ? todayCalories.ToString("N0") : "—";
            todayCaloriesNote = todayCalories > 0 ? $"Target: {calorieGoal:N0}" : "No meals logged";

            var activeDates = new HashSet<DateTime>();
            foreach (var w in workoutLogs) activeDates.Add(w.WorkoutDateTime.Date);
            foreach (var d in dietLogs) activeDates.Add(d.LogDate.Date);

            streakDays = 0;
            for (var d = today; ; d = d.AddDays(-1))
            {
                if (!activeDates.Contains(d)) break;
                streakDays++;
            }

            streakNote = streakDays >= 7 ? "Nice streak 🔥" : "Keep it going";

            ComputeProgressWeek(workoutLogs);

            // ✅ always show ACTIVE plan + only TODAY exercises
            await BuildTodayPlanFromActivePlan(db, today);

            BuildRecentActivity(workoutLogs, dietLogs);
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            loading = false;
        }
    }

    private static int ToMonSunNumber(DayOfWeek d)
        => d == DayOfWeek.Sunday ? 7 : (int)d;

    private async Task SaveActivePlan(The_Right_Fit.Data.The_Right_FitContext db, int planId)
    {
        var ok = await db.WorkoutPlan
            .AsNoTracking()
            .AnyAsync(x =>
                x.Id == planId &&
                (string.IsNullOrWhiteSpace(x.OwnerIdentityUserId) || x.OwnerIdentityUserId == identityUserId));

        if (!ok) return;

        var row = await db.UserActivePlan.FirstOrDefaultAsync(x => x.OwnerIdentityUserId == identityUserId);

        if (row is null)
        {
            db.UserActivePlan.Add(new UserActivePlan
            {
                OwnerIdentityUserId = identityUserId!,
                WorkoutPlanId = planId,
                DateUpdated = DateTime.Now
            });
        }
        else
        {
            row.WorkoutPlanId = planId;
            row.DateUpdated = DateTime.Now;
        }

        await db.SaveChangesAsync();
    }

    private async Task<int?> LoadActivePlan(The_Right_Fit.Data.The_Right_FitContext db)
    {
        var row = await db.UserActivePlan
            .AsNoTracking()
            .FirstOrDefaultAsync(x => x.OwnerIdentityUserId == identityUserId);

        return row?.WorkoutPlanId;
    }

    private void ComputeProgressWeek(List<WorkoutLog> workoutLogs)
    {
        var today = DateTime.Today;
        var start = StartOfWeek(today, DayOfWeek.Monday);
        var end = start.AddDays(7);

        progressWorkoutsGoal = 5;
        progressWorkoutsDone = workoutLogs.Count(x => x.WorkoutDateTime >= start && x.WorkoutDateTime < end);
        progressWorkoutsPct = Percent(progressWorkoutsDone, progressWorkoutsGoal);
    }

    private async Task BuildTodayPlanFromActivePlan(The_Right_Fit.Data.The_Right_FitContext db, DateTime today)
    {
        todayPlanItems.Clear();

        if (selectedPlanId is null)
        {
            todayPlanTitle = "Today";
            return;
        }

        var plan = await db.WorkoutPlan
            .AsNoTracking()
            .FirstOrDefaultAsync(x =>
                x.Id == selectedPlanId.Value &&
                (string.IsNullOrWhiteSpace(x.OwnerIdentityUserId) || x.OwnerIdentityUserId == identityUserId));

        if (plan is null)
        {
            todayPlanTitle = "Today";
            return;
        }

        todayPlanTitle = string.IsNullOrWhiteSpace(plan.PlanName) ? "Active Plan" : plan.PlanName;

        var todayDay = ToMonSunNumber(today.DayOfWeek); // 1–7 (Mon–Sun)

        var planEx = await db.WorkoutPlanExercise
            .AsNoTracking()
            .Where(x => x.WorkoutPlanId == plan.Id)
            .Where(x => x.DayOfWeek == todayDay)
            .OrderBy(x => x.Id)
            .ToListAsync();

        if (planEx.Count == 0)
        {
            todayPlanItems.Add(new PlanItem("Rest day / No exercises scheduled", $"Day {todayDay}"));
            return;
        }

        var ids = planEx.Select(x => x.ExerciseId).Distinct().ToList();

        var nameMap = await db.Exercise
            .AsNoTracking()
            .Where(x => ids.Contains(x.Id))
            .ToDictionaryAsync(x => x.Id, x => x.ExerciseName);

        foreach (var row in planEx)
        {
            var name = nameMap.TryGetValue(row.ExerciseId, out var n) ? n : $"Exercise #{row.ExerciseId}";
            todayPlanItems.Add(new PlanItem(name, $"{row.Sets} sets • {row.Reps} reps"));
        }
    }

    private void BuildRecentActivity(List<WorkoutLog> workoutLogs, List<DietLog> dietLogs)
    {
        recent.Clear();

        foreach (var w in workoutLogs.Take(2))
        {
            recent.Add(new ActivityItem(
                Title: "Workout",
                Subtitle: $"{w.WorkoutDateTime:ddd, dd MMM} • {w.DurationMinutes} min",
                Tag: "Completed",
                DotStyle: "",
                TagStyle: ""
            ));
        }

        foreach (var d in dietLogs.Take(2))
        {
            var meal = string.IsNullOrWhiteSpace(d.MealType) ? "Meal" : d.MealType;

            recent.Add(new ActivityItem(
                Title: "Meal Logged",
                Subtitle: $"{meal} • {d.LogDate:ddd, dd MMM} • {d.TotalCalories} kcal",
                Tag: "Logged",
                DotStyle: "background: rgba(16,185,129,1); box-shadow: 0 0 0 6px rgba(16,185,129,.14);",
                TagStyle: "background: rgba(16,185,129,.12); border-color: rgba(16,185,129,.2); color: rgba(5,150,105,1);"
            ));
        }
    }

    private static DateTime StartOfWeek(DateTime dt, DayOfWeek startOfWeek)
    {
        int diff = (7 + (dt.DayOfWeek - startOfWeek)) % 7;
        return dt.AddDays(-1 * diff).Date;
    }

    private static int Percent(int value, int goal)
    {
        if (goal <= 0) return 0;
        var pct = (int)Math.Round((double)value * 100.0 / goal);
        return Math.Clamp(pct, 0, 100);
    }
}
