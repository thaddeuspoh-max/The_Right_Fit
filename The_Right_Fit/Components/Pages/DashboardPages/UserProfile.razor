@page "/profile"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Components.Authorization
@using The_Right_Fit.Data
@inject NavigationManager Nav
@inject UserManager<The_Right_FitUser> UserManager
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>My Profile</PageTitle>

<div class="wp">
    <div class="wp-head">
        <div>
            <h1 class="wp-title">My Profile</h1>
            <div class="wp-sub">Update your details for better recommendations.</div>
        </div>

        <NavLink class="wp-newbtn" href="/">Back</NavLink>
    </div>

    @if (user is null)
    {
        <div class="wp-loading">Loading profile…</div>
    }
    else
    {
        <div class="wp-card">
            <EditForm Model="form" OnValidSubmit="Save">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="wp-form">
                    <div class="wp-formgrid">
                        <div class="wp-field">
                            <label class="wp-label">First Name</label>
                            <InputText class="wp-input" @bind-Value="form.FirstName" />
                        </div>

                        <div class="wp-field">
                            <label class="wp-label">Last Name</label>
                            <InputText class="wp-input" @bind-Value="form.LastName" />
                        </div>

                        <div class="wp-field">
                            <label class="wp-label">Height (cm)</label>
                            <InputNumber class="wp-input" @bind-Value="form.HeightCm" />
                        </div>

                        <div class="wp-field">
                            <label class="wp-label">Weight (kg)</label>
                            <InputNumber class="wp-input" @bind-Value="form.WeightKg" />
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(message))
                    {
                        <div class="wp-success">@message</div>
                    }
                </div>

                <div class="wp-actionsbar">
                    <button class="wp-newbtn" type="submit">Save</button>
                </div>
            </EditForm>
        </div>
    }
</div>

@code {
    private The_Right_FitUser? user;
    private ProfileForm form = new();
    private string? message;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var principal = authState.User;

        if (principal.Identity?.IsAuthenticated != true)
            return;

        user = await UserManager.GetUserAsync(principal);
        if (user is null) return;

        form = new ProfileForm
        {
            FirstName = user.FirstName,
            LastName = user.LastName,
            HeightCm = user.HeightCm,
            WeightKg = user.WeightKg
        };
    }

    private async Task Save()
    {
        if (user is null) return;

        user.FirstName = form.FirstName;
        user.LastName = form.LastName;
        user.HeightCm = form.HeightCm;
        user.WeightKg = form.WeightKg;

        var result = await UserManager.UpdateAsync(user);

        message = result.Succeeded
            ? "Profile saved!"
            : string.Join("; ", result.Errors.Select(e => e.Description));
    }

    private class ProfileForm
    {
        public string FirstName { get; set; } = "";
        public string LastName { get; set; } = "";
        public double? HeightCm { get; set; }
        public double? WeightKg { get; set; }
    }
}
