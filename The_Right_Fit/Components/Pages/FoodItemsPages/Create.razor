@page "/fooditems/create"
@rendermode InteractiveServer

@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using The_Right_Fit.Domain
@using The_Right_Fit.Data

@inject IDbContextFactory<The_Right_FitContext> DbFactory
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav

<PageTitle>Create Food Item</PageTitle>

<div class="wp">

    <div class="wp-head">
        <div>
            <h1 class="wp-title">Create Food Item</h1>
            <div class="wp-sub">Add a food item. Admin items become Standard (global). Users create Custom.</div>
        </div>

        <a class="wp-linkbtn" href="/fooditems">Back</a>
    </div>

    @if (!string.IsNullOrWhiteSpace(error))
    {
        <div class="wp-empty">
            <div class="wp-empty-title">Cannot create</div>
            <div class="wp-empty-sub">@error</div>
        </div>
    }

    <EditForm Model="food" OnValidSubmit="Save">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="wp-card" style="padding:18px;">
            <div style="display:grid; gap:14px;">

                <div>
                    <div class="wp-label">Name</div>
                    <InputText class="wp-input" @bind-Value="food.Name" />
                    <ValidationMessage For="() => food.Name" class="validation-message" />
                </div>

                <div>
                    <div class="wp-label">Serving Size Description</div>
                    <InputText class="wp-input" @bind-Value="food.ServingSizeDescription" />
                    <ValidationMessage For="() => food.ServingSizeDescription" class="validation-message" />
                </div>

                <div style="max-width:240px;">
                    <div class="wp-label">Calories</div>
                    <InputNumber class="wp-input" @bind-Value="food.Calories" />
                    <ValidationMessage For="() => food.Calories" class="validation-message" />
                </div>

                <div style="display:flex; gap:12px; justify-content:flex-end; flex-wrap:wrap; margin-top:6px;">
                    <button type="submit" class="wp-newbtn">Create</button>
                    <a class="wp-linkbtn" href="/fooditems">Cancel</a>
                </div>

            </div>
        </div>
    </EditForm>

</div>

@code {
    private FoodItems food = new();
    private string? error;

    private string? currentUserId;
    private string displayName = "User";
    private bool isAdmin = false;
    private bool ready = false;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = auth.User;

        if (user.Identity?.IsAuthenticated != true)
        {
            Nav.NavigateTo("/Identity/Account/Login", true);
            return;
        }

        displayName =
            user.FindFirstValue(ClaimTypes.Name)
            ?? user.FindFirstValue(ClaimTypes.Email)
            ?? user.Identity?.Name
            ?? "User";

        currentUserId = user.FindFirstValue(ClaimTypes.NameIdentifier);

        if (string.IsNullOrWhiteSpace(currentUserId))
        {
            error = "Cannot determine your user id. Please log out and log in again.";
            ready = false;
            return;
        }

        // ✅ match your FoodItems index page check
        isAdmin = user.IsInRole("Admin") || user.IsInRole("Administrator");

        ready = true;
    }

    private async Task Save()
    {
        if (!ready)
        {
            error ??= "You are not allowed to create food items right now.";
            return;
        }

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            // ✅ OPTION 1:
            // Admin creates GLOBAL (Standard) food so all users can see it.
            // Normal users create Custom food (owned by them).
            if (isAdmin)
            {
                food.IsCustom = 0;                 // Standard/global
                food.CreatedByUserId = null;       // If DB disallows null, set to currentUserId instead
            }
            else
            {
                food.IsCustom = 1;                 // Custom
                food.CreatedByUserId = currentUserId;
            }

            // Audit
            food.CreatedBy = displayName;
            food.DateCreated = DateTime.Now;

            food.UpdatedBy = displayName;
            food.DateUpdated = DateTime.Now;

            db.FoodItems.Add(food);
            await db.SaveChangesAsync();

            Nav.NavigateTo("/fooditems", true);
        }
        catch (DbUpdateException ex)
        {
            error =
                ex.InnerException?.InnerException?.Message
                ?? ex.InnerException?.Message
                ?? ex.Message;
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }
}
