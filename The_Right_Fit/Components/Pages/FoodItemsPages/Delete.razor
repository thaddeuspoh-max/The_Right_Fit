@page "/fooditems/delete/{Id:int}"
@rendermode InteractiveServer

@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using The_Right_Fit.Domain
@using The_Right_Fit.Data

@inject IDbContextFactory<The_Right_FitContext> DbFactory
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav

<PageTitle>Delete Food Item</PageTitle>

<div class="wp">
    <div class="wp-head">
        <div>
            <h1 class="wp-title">Delete Food Item</h1>
            <div class="wp-sub">This action cannot be undone.</div>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="wp-loading">Loading…</div>
    }
    else if (!string.IsNullOrWhiteSpace(error))
    {
        <div class="wp-empty">
            <div class="wp-empty-title">Cannot delete</div>
            <div class="wp-empty-sub">@error</div>
        </div>
    }
    else if (food is null)
    {
        <div class="wp-loading">Food item not found.</div>
    }
    else
    {
        <div class="wp-card" style="padding:18px;">
            <div class="wp-name">@Safe(food.Name, "Untitled Food")</div>

            <div class="wp-desc" style="min-height:auto;">
                <div><strong>Serving:</strong> @Safe(food.ServingSizeDescription, "—")</div>
                <div><strong>Calories:</strong> @($"{food.Calories:0}") kcal</div>
                <div><strong>Type:</strong> @(food.IsCustom == 1 ? "Custom" : "Standard")</div>
            </div>

            <div class="wp-dangerbox">
                <div class="wp-danger-title">Warning</div>
                <div class="wp-danger-sub">
                    Deleting this food item will permanently remove it. Any diet logs using it may be affected.
                </div>
            </div>

            <div class="wp-actions">
                <button class="wp-newbtn wp-btn-danger" @onclick="ConfirmDelete">
                    Delete
                </button>

                <a class="wp-linkbtn" href="/fooditems">
                    Cancel
                </a>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public int Id { get; set; }

    private FoodItems? food;
    private bool isLoading = true;
    private string? error;

    private bool isAdmin;
    private string? currentUserId; // ✅ GUID string

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var auth = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = auth.User;

            if (user.Identity?.IsAuthenticated != true)
            {
                Nav.NavigateTo("/Identity/Account/Login", true);
                return;
            }

            isAdmin = user.IsInRole("Administrator");
            currentUserId = user.FindFirstValue(ClaimTypes.NameIdentifier);

            await using var db = await DbFactory.CreateDbContextAsync();
            food = await db.FoodItems.FirstOrDefaultAsync(f => f.Id == Id);

            if (food is null)
            {
                error = "Food item not found.";
                return;
            }

            // ✅ Security: Admin OR (custom + owner)
            var isOwner =
                !string.IsNullOrWhiteSpace(currentUserId)
                && !string.IsNullOrWhiteSpace(food.CreatedByUserId)
                && food.CreatedByUserId == currentUserId;

            if (!isAdmin && !(food.IsCustom == 1 && isOwner))
            {
                Nav.NavigateTo("/fooditems", true);
                return;
            }
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ConfirmDelete()
    {
        if (food is null) return;

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            // Optional: remove links if you have DietLogFood join table (uncomment if needed)
            // var links = await db.DietLogFood.Where(x => x.FoodItemsId == food.Id).ToListAsync();
            // if (links.Any()) db.DietLogFood.RemoveRange(links);

            db.FoodItems.Remove(food);
            await db.SaveChangesAsync();

            Nav.NavigateTo("/fooditems");
        }
        catch (DbUpdateConcurrencyException)
        {
            error = "This record was updated by someone else. Reload and try again.";
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }

    private static string Safe(string? v, string fallback) =>
        string.IsNullOrWhiteSpace(v) ? fallback : v;
}
