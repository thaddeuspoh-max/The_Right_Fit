@page "/exercises/details"
@using Microsoft.EntityFrameworkCore
@using The_Right_Fit.Domain
@inject IDbContextFactory<The_Right_Fit.Data.The_Right_FitContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Details</PageTitle>

<h1>Details</h1>

<div>
    <h2>Exercise</h2>
    <hr />
    @if (exercise is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">ExerciseName</dt>
            <dd class="col-sm-10">@exercise.ExerciseName</dd>
            <dt class="col-sm-2">MuscleGroup</dt>
            <dd class="col-sm-10">@exercise.MuscleGroup</dd>
            <dt class="col-sm-2">EquipmentNeeded</dt>
            <dd class="col-sm-10">@exercise.EquipmentNeeded</dd>
            <dt class="col-sm-2">Instructions</dt>
            <dd class="col-sm-10">@exercise.Instructions</dd>
            <dt class="col-sm-2">VideoUrl</dt>
            <dd class="col-sm-10">@exercise.VideoUrl</dd>
            <dt class="col-sm-2">DateCreated</dt>
            <dd class="col-sm-10">@exercise.DateCreated</dd>
            <dt class="col-sm-2">DateUpdated</dt>
            <dd class="col-sm-10">@exercise.DateUpdated</dd>
            <dt class="col-sm-2">CreatedBy</dt>
            <dd class="col-sm-10">@exercise.CreatedBy</dd>
            <dt class="col-sm-2">UpdatedBy</dt>
            <dd class="col-sm-10">@exercise.UpdatedBy</dd>
        </dl>
        <div>
            <a href="@($"/exercises/edit?id={exercise.Id}")">Edit</a> |
            <a href="@($"/exercises")">Back to List</a>
        </div>
    }
</div>

@code {
    private Exercise? exercise;

    [SupplyParameterFromQuery]
    private int Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        exercise = await context.Exercise.FirstOrDefaultAsync(m => m.Id == Id);

        if (exercise is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }
}
