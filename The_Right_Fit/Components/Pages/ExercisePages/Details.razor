@page "/exercises/details/{Id:int}"
@rendermode InteractiveServer

@using Microsoft.EntityFrameworkCore
@using The_Right_Fit.Domain
@using The_Right_Fit.Data

@inject IDbContextFactory<The_Right_FitContext> DbFactory
@inject NavigationManager Nav

<PageTitle>Exercise Details</PageTitle>

<div class="wp">

    <div class="wp-head">
        <div>
            <h1 class="wp-title">Exercise Details</h1>
            <div class="wp-sub">Full information about the selected exercise.</div>
        </div>

        <a class="wp-newbtn" href="/exercises">
            Back
        </a>

    </div>

    @if (exercise is null && isLoading)
    {
        <div class="wp-loading">Loading…</div>
    }
    else if (!string.IsNullOrWhiteSpace(error))
    {
        <div class="wp-empty">
            <div class="wp-empty-title">Cannot load exercise</div>
            <div class="wp-empty-sub">@error</div>
        </div>
    }
    else if (exercise is null)
    {
        <div class="wp-empty">
            <div class="wp-empty-title">Not found</div>
            <div class="wp-empty-sub">This exercise does not exist.</div>
        </div>
    }
    else
    {
        <div class="wp-card" style="padding:18px;">
            <div style="display:flex; justify-content:space-between; align-items:flex-start; gap:12px; flex-wrap:wrap;">
                <div>
                    <div style="font-size:22px; font-weight:950; letter-spacing:-.02em;">
                        @exercise.ExerciseName
                    </div>
                    <div style="margin-top:10px;">
                        <span class="wp-pill">@exercise.MuscleGroup</span>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(exercise.VideoUrl))
                {
                    <a class="wp-yt"
                       href="@exercise.VideoUrl"
                       target="_blank"
                       rel="noopener noreferrer"
                       title="Open video in new tab">
                        ▶ YouTube
                    </a>
                }
            </div>

            <div class="wp-divider" style="margin:16px 0;"></div>

            <div style="display:grid; grid-template-columns: 240px 1fr; gap:14px; align-items:start;">
                <div class="wp-label">Equipment Needed</div>
                <div style="font-weight:750;">
                    @(string.IsNullOrWhiteSpace(exercise.EquipmentNeeded) ? "None" : exercise.EquipmentNeeded)
                </div>

                <div class="wp-label">Instructions</div>
                <div class="wp-wraptext">
                    @exercise.Instructions
                </div>
            </div>

            <div class="wp-divider" style="margin:16px 0;"></div>

            <div style="display:grid; grid-template-columns: 240px 1fr; gap:14px;">
                <div class="wp-label">Created</div>
                <div style="font-weight:750;">
                    @exercise.DateCreated
                    @if (!string.IsNullOrWhiteSpace(exercise.CreatedBy))
                    {
                        <span style="color:rgba(15,23,42,.65); font-weight:700;"> · @exercise.CreatedBy</span>
                    }
                </div>

                <div class="wp-label">Last Updated</div>
                <div style="font-weight:750;">
                    @exercise.DateUpdated
                    @if (!string.IsNullOrWhiteSpace(exercise.UpdatedBy))
                    {
                        <span style="color:rgba(15,23,42,.65); font-weight:700;"> · @exercise.UpdatedBy</span>
                    }
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public int Id { get; set; }

    private Exercise? exercise;
    private bool isLoading = true;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await using var context = await DbFactory.CreateDbContextAsync();
            exercise = await context.Exercise.AsNoTracking()
                .FirstOrDefaultAsync(e => e.Id == Id);

            if (exercise is null)
            {
                // optional: redirect to a "notfound" route if you have one
                // Nav.NavigateTo("/notfound");
            }
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }
}
