@page "/exercises/edit/{Id:int}"
@rendermode InteractiveServer

@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using The_Right_Fit.Domain
@using The_Right_Fit.Data

@inject IDbContextFactory<The_Right_FitContext> DbFactory
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav

<PageTitle>Edit Exercise</PageTitle>

<div class="wp">

    <div class="wp-head">
        <div>
            <h1 class="wp-title">Edit Exercise</h1>
            <div class="wp-sub">Update exercise details. Audit fields are locked.</div>
        </div>

        <a class="wp-linkbtn" href="/exercises">
            Back
        </a>

    </div>

    @if (isLoading)
    {
        <div class="wp-loading">Loading…</div>
    }
    else if (!string.IsNullOrWhiteSpace(error))
    {
        <div class="wp-empty">
            <div class="wp-empty-title">Cannot edit</div>
            <div class="wp-empty-sub">@error</div>
        </div>
    }
    else if (exercise is null)
    {
        <div class="wp-empty">
            <div class="wp-empty-title">Not found</div>
            <div class="wp-empty-sub">This exercise does not exist.</div>
        </div>
    }
    else
    {
        <EditForm Model="exercise" OnValidSubmit="Save">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="wp-card" style="padding:18px;">
                <div style="display:grid; gap:14px;">

                    <div>
                        <div class="wp-label">Exercise Name</div>
                        <InputText class="wp-input" @bind-Value="exercise.ExerciseName" />
                        <ValidationMessage For="() => exercise.ExerciseName" class="validation-message" />
                    </div>

                    <div>
                        <div class="wp-label">Muscle Group</div>
                        <InputText class="wp-input" @bind-Value="exercise.MuscleGroup" />
                        <ValidationMessage For="() => exercise.MuscleGroup" class="validation-message" />
                    </div>

                    <div>
                        <div class="wp-label">Equipment Needed</div>
                        <InputText class="wp-input" @bind-Value="exercise.EquipmentNeeded" />
                        <ValidationMessage For="() => exercise.EquipmentNeeded" class="validation-message" />
                    </div>

                    <div>
                        <div class="wp-label">Instructions</div>
                        <InputTextArea class="wp-input" rows="4" @bind-Value="exercise.Instructions" />
                        <ValidationMessage For="() => exercise.Instructions" class="validation-message" />
                    </div>

                    <div>
                        <div class="wp-label">Video URL (YouTube)</div>
                        <InputText class="wp-input" @bind-Value="exercise.VideoUrl" />
                        <ValidationMessage For="() => exercise.VideoUrl" class="validation-message" />
                    </div>

                    <div class="wp-divider"></div>

                    <!-- ✅ Audit fields: DISPLAY ONLY (NOT binded) -->
                    <div style="display:grid; grid-template-columns: 1fr 1fr; gap:14px;">
                        <div>
                            <div class="wp-label">Created By</div>
                            <input class="wp-input" value="@exercise.CreatedBy" disabled />
                        </div>

                        <div>
                            <div class="wp-label">Date Created</div>
                            <input class="wp-input" value="@exercise.DateCreated.ToString("yyyy-MM-dd HH:mm")" disabled />
                        </div>

                        <div>
                            <div class="wp-label">Updated By</div>
                            <input class="wp-input" value="@exercise.UpdatedBy" disabled />
                        </div>

                        <div>
                            <div class="wp-label">Date Updated</div>
                            <input class="wp-input" value="@exercise.DateUpdated.ToString("yyyy-MM-dd HH:mm")" disabled />
                        </div>
                    </div>

                    <div style="display:flex; gap:12px; justify-content:flex-end; flex-wrap:wrap; margin-top:6px;">
                        <button type="submit" class="wp-newbtn">
                            Save Changes
                        </button>
                        <a class="wp-linkbtn" href="/exercises">
                            Cancel
                        </a>

                    </div>

                </div>
            </div>
        </EditForm>
    }
</div>

@code {
    [Parameter] public int Id { get; set; }

    private bool isLoading = true;
    private string? error;

    private Exercise? exercise;

    private bool isAdmin;
    private string adminDisplayName = "Admin";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var auth = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = auth.User;

            if (user.Identity?.IsAuthenticated != true)
            {
                Nav.NavigateTo("/Identity/Account/Login", true);
                return;
            }

            isAdmin = user.IsInRole("Administrator");
            if (!isAdmin)
            {
                // ✅ Non-admins cannot access edit page
                Nav.NavigateTo("/exercises", true);
                return;
            }

            adminDisplayName =
                user.FindFirstValue(ClaimTypes.Name)
                ?? user.FindFirstValue(ClaimTypes.Email)
                ?? user.Identity?.Name
                ?? "Admin";

            await using var db = await DbFactory.CreateDbContextAsync();
            exercise = await db.Exercise.FirstOrDefaultAsync(e => e.Id == Id);

            if (exercise is null)
                error = "Exercise not found.";
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task Save()
    {
        if (exercise is null) return;

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            // ✅ Force audit fields (cannot be edited by UI)
            exercise.UpdatedBy = adminDisplayName;
            exercise.DateUpdated = DateTime.Now;

            db.Attach(exercise);
            db.Entry(exercise).State = EntityState.Modified;

            // ✅ Security: never allow Created fields to be modified
            db.Entry(exercise).Property(x => x.CreatedBy).IsModified = false;
            db.Entry(exercise).Property(x => x.DateCreated).IsModified = false;

            // ✅ Ensure Updated fields ARE written
            db.Entry(exercise).Property(x => x.UpdatedBy).IsModified = true;
            db.Entry(exercise).Property(x => x.DateUpdated).IsModified = true;

            await db.SaveChangesAsync();
            Nav.NavigateTo("/exercises");
        }
        catch (DbUpdateConcurrencyException)
        {
            error = "This record was updated by someone else. Reload and try again.";
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }
}
