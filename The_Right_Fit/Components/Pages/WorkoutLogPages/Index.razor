@page "/workoutlogs"
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.QuickGrid
@using The_Right_Fit.Domain
@using The_Right_Fit.Data
@implements IAsyncDisposable
@inject IDbContextFactory<The_Right_Fit.Data.The_Right_FitContext> DbFactory

<PageTitle>Index</PageTitle>

<h1>Index</h1>

<p>
    <a href="workoutlogs/create">Create New</a>
</p>

<QuickGrid Class="table" Items="context.WorkoutLog">
    <PropertyColumn Property="workoutlog => workoutlog.UserId" />
    <PropertyColumn Property="workoutlog => workoutlog.WorkoutPlanId" />
    <PropertyColumn Property="workoutlog => workoutlog.WorkoutDateTime" />
    <PropertyColumn Property="workoutlog => workoutlog.DurationMinutes" />
    <PropertyColumn Property="workoutlog => workoutlog.Notes" />
    <PropertyColumn Property="workoutlog => workoutlog.DateCreated" />
    <PropertyColumn Property="workoutlog => workoutlog.DateUpdated" />
    <PropertyColumn Property="workoutlog => workoutlog.CreatedBy" />
    <PropertyColumn Property="workoutlog => workoutlog.UpdatedBy" />

    <TemplateColumn Context="workoutlog">
        <a href="@($"workoutlogs/edit?id={workoutlog.Id}")">Edit</a> |
        <a href="@($"workoutlogs/details?id={workoutlog.Id}")">Details</a> |
        <a href="@($"workoutlogs/delete?id={workoutlog.Id}")">Delete</a>
    </TemplateColumn>
</QuickGrid>

@code {
    private The_Right_FitContext context = default!;

    protected override void OnInitialized()
    {
        context = DbFactory.CreateDbContext();
    }

    public async ValueTask DisposeAsync() => await context.DisposeAsync();
}
