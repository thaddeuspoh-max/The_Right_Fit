@page "/workoutlogs/delete/{Id:int}"
@rendermode InteractiveServer

@using Microsoft.EntityFrameworkCore
@using The_Right_Fit.Domain
@inject IDbContextFactory<The_Right_Fit.Data.The_Right_FitContext> DbFactory
@inject NavigationManager Nav

<PageTitle>Delete Workout Log</PageTitle>

<div class="wp">
    <div class="wp-head">
        <div>
            <h1 class="wp-title">Delete Workout Log</h1>
            <div class="wp-sub">This action cannot be undone.</div>
        </div>

        <NavLink class="wp-linkbtn" href="/workoutlogs">Back</NavLink>
    </div>

    @if (isLoading)
    {
        <div class="wp-loading">Loading…</div>
    }
    else if (!string.IsNullOrWhiteSpace(error))
    {
        <div class="wp-empty">
            <div class="wp-empty-title">Cannot delete</div>
            <div class="wp-empty-sub">@error</div>
        </div>
    }
    else if (log == null)
    {
        <div class="wp-loading">Workout log not found.</div>
    }
    else
    {
        <div class="wp-card del-card">

            <div class="del-top">
                <div class="del-title">Workout Log</div>
                <div class="del-meta">
                    <span class="del-pill">Session</span>
                    <span class="del-date">@log.WorkoutDateTime.ToString("ddd, dd MMM yyyy • h:mm tt")</span>
                </div>
            </div>

            <div class="del-summary">

                <div class="del-item">
                    <div class="del-label">Duration</div>
                    <div class="del-value">@log.DurationMinutes min</div>
                </div>

                <div class="del-item">
                    <div class="del-label">Exercises</div>
                    <div class="del-value">@exerciseCount</div>
                </div>

                <div class="del-item">
                    <div class="del-label">Plan</div>
                    <div class="del-value">
                        @(log.WorkoutPlanId is null ? "No plan" : $"Plan #{log.WorkoutPlanId}")
                    </div>
                </div>

            </div>

            <div class="del-notes">
                <div class="del-label">Notes</div>
                <div class="del-notesbox">
                    @SafeShort(log.Notes, "—")
                </div>
            </div>

            <div class="wp-dangerbox del-danger">
                <div class="wp-danger-title">Warning</div>
                <div class="wp-danger-sub">
                    Deleting this workout log will permanently remove it and all its logged exercises.
                </div>
            </div>

            <div class="del-actions">
                <button class="wp-newbtn wp-btn-danger"
                        disabled="@isDeleting"
                        @onclick="ConfirmDelete">
                    @(isDeleting ? "Deleting…" : "Delete")
                </button>

                <button class="wp-newbtn wp-btn-secondary"
                        type="button"
                        disabled="@isDeleting"
                        @onclick="@(() => Nav.NavigateTo("/workoutlogs"))">
                    Cancel
                </button>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public int Id { get; set; }

    private bool isLoading = true;
    private bool isDeleting = false;
    private string? error;

    private WorkoutLog? log;
    private int exerciseCount = 0;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        error = null;

        try
        {
            using var db = DbFactory.CreateDbContext();

            log = await db.WorkoutLog
                .AsNoTracking()
                .FirstOrDefaultAsync(x => x.Id == Id);

            if (log is null)
            {
                error = "Workout log not found.";
                return;
            }

            exerciseCount = await db.WorkoutLogExercise
                .AsNoTracking()
                .CountAsync(x => x.WorkoutLogId == Id);
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ConfirmDelete()
    {
        if (isDeleting) return;
        error = null;

        try
        {
            isDeleting = true;

            using var db = DbFactory.CreateDbContext();

            var tracked = await db.WorkoutLog
                .FirstOrDefaultAsync(x => x.Id == Id);

            if (tracked is null)
            {
                error = "Workout log not found.";
                return;
            }

            // delete children first (FK safety)
            var children = await db.WorkoutLogExercise
                .Where(x => x.WorkoutLogId == Id)
                .ToListAsync();

            if (children.Count > 0)
                db.WorkoutLogExercise.RemoveRange(children);

            db.WorkoutLog.Remove(tracked);

            await db.SaveChangesAsync();

            Nav.NavigateTo("/workoutlogs");
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            isDeleting = false;
        }
    }

    private static string SafeShort(string? v, string fallback)
    {
        if (string.IsNullOrWhiteSpace(v)) return fallback;
        var t = v.Trim();
        return t.Length <= 180 ? t : (t.Substring(0, 180) + "…");
    }
}
