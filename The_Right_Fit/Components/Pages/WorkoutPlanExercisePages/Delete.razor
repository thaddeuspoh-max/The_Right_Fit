@page "/workoutplanexercises/delete"
@using Microsoft.EntityFrameworkCore
@using The_Right_Fit.Domain
@inject IDbContextFactory<The_Right_Fit.Data.The_Right_FitContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Delete</PageTitle>

<h1>Delete</h1>

<p>Are you sure you want to delete this?</p>
<div>
    <h2>WorkoutPlanExercise</h2>
    <hr />
    @if (workoutplanexercise is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">WorkoutPlanId</dt>
            <dd class="col-sm-10">@workoutplanexercise.WorkoutPlanId</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">ExerciseId</dt>
            <dd class="col-sm-10">@workoutplanexercise.ExerciseId</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">DayOfWeek</dt>
            <dd class="col-sm-10">@workoutplanexercise.DayOfWeek</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Sets</dt>
            <dd class="col-sm-10">@workoutplanexercise.Sets</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Reps</dt>
            <dd class="col-sm-10">@workoutplanexercise.Reps</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">DateCreated</dt>
            <dd class="col-sm-10">@workoutplanexercise.DateCreated</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">DateUpdated</dt>
            <dd class="col-sm-10">@workoutplanexercise.DateUpdated</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">CreatedBy</dt>
            <dd class="col-sm-10">@workoutplanexercise.CreatedBy</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">UpdatedBy</dt>
            <dd class="col-sm-10">@workoutplanexercise.UpdatedBy</dd>
        </dl>
        <EditForm method="post" Model="workoutplanexercise" OnValidSubmit="DeleteWorkoutPlanExercise" FormName="delete" Enhance>
            <button type="submit" class="btn btn-danger" disabled="@(workoutplanexercise is null)">Delete</button> |
            <a href="/workoutplanexercises">Back to List</a>
        </EditForm>
    }
</div>

@code {
    private WorkoutPlanExercise? workoutplanexercise;

    [SupplyParameterFromQuery]
    private int Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        workoutplanexercise = await context.WorkoutPlanExercise.FirstOrDefaultAsync(m => m.Id == Id);

        if (workoutplanexercise is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    private async Task DeleteWorkoutPlanExercise()
    {
        using var context = DbFactory.CreateDbContext();
        context.WorkoutPlanExercise.Remove(workoutplanexercise!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/workoutplanexercises");
    }
}
