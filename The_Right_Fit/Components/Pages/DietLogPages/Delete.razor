@page "/dietlogs/delete"
@using Microsoft.EntityFrameworkCore
@using The_Right_Fit.Domain
@inject IDbContextFactory<The_Right_Fit.Data.The_Right_FitContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Delete</PageTitle>

<h1>Delete</h1>

<p>Are you sure you want to delete this?</p>
<div>
    <h2>DietLog</h2>
    <hr />
    @if (dietlog is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">UserId</dt>
            <dd class="col-sm-10">@dietlog.UserId</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">FoodItemId</dt>
            <dd class="col-sm-10">@dietlog.FoodItemId</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">LogDate</dt>
            <dd class="col-sm-10">@dietlog.LogDate</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">MealType</dt>
            <dd class="col-sm-10">@dietlog.MealType</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">QuantityServings</dt>
            <dd class="col-sm-10">@dietlog.QuantityServings</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">TotalCalories</dt>
            <dd class="col-sm-10">@dietlog.TotalCalories</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">CustomFoodName</dt>
            <dd class="col-sm-10">@dietlog.CustomFoodName</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">DateCreated</dt>
            <dd class="col-sm-10">@dietlog.DateCreated</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">DateUpdated</dt>
            <dd class="col-sm-10">@dietlog.DateUpdated</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">CreatedBy</dt>
            <dd class="col-sm-10">@dietlog.CreatedBy</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">UpdatedBy</dt>
            <dd class="col-sm-10">@dietlog.UpdatedBy</dd>
        </dl>
        <EditForm method="post" Model="dietlog" OnValidSubmit="DeleteDietLog" FormName="delete" Enhance>
            <button type="submit" class="btn btn-danger" disabled="@(dietlog is null)">Delete</button> |
            <a href="/dietlogs">Back to List</a>
        </EditForm>
    }
</div>

@code {
    private DietLog? dietlog;

    [SupplyParameterFromQuery]
    private int Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        dietlog = await context.DietLog.FirstOrDefaultAsync(m => m.Id == Id);

        if (dietlog is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    private async Task DeleteDietLog()
    {
        using var context = DbFactory.CreateDbContext();
        context.DietLog.Remove(dietlog!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/dietlogs");
    }
}
