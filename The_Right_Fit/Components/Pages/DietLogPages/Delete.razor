@page "/dietlogs/delete/{Id:int}"
@rendermode InteractiveServer

@using Microsoft.EntityFrameworkCore
@using The_Right_Fit.Domain

@inject IDbContextFactory<The_Right_Fit.Data.The_Right_FitContext> DbFactory
@inject NavigationManager Nav

<PageTitle>Delete Diet Log</PageTitle>

<div class="wp">
    <div class="wp-head">
        <div>
            <h1 class="wp-title">Delete Diet Log</h1>
            <div class="wp-sub">This action cannot be undone.</div>
        </div>

        <NavLink class="wp-linkbtn" href="/dietlogs">Back</NavLink>
    </div>

    @if (isLoading)
    {
        <div class="wp-loading">Loading…</div>
    }
    else if (!string.IsNullOrWhiteSpace(error))
    {
        <div class="wp-empty">
            <div class="wp-empty-title">Cannot delete</div>
            <div class="wp-empty-sub">@error</div>
        </div>
    }
    else if (log is null)
    {
        <div class="wp-loading">Diet log not found.</div>
    }
    else
    {
        <div class="wp-card del-card">

            <div class="del-top">
                <div class="del-title">Diet Log</div>
                <div class="del-meta">
                    <span class="del-pill">@(!string.IsNullOrWhiteSpace(log.MealType) ? log.MealType : "Meal")</span>
                    <span class="del-date">@log.LogDate.ToString("ddd, dd MMM yyyy")</span>
                </div>
            </div>

            <div class="del-summary">
                <div class="del-item">
                    <div class="del-label">Food</div>
                    <div class="del-value">@foodName</div>
                </div>

                <div class="del-item">
                    <div class="del-label">Servings</div>
                    <div class="del-value">@log.QuantityServings</div>
                </div>

                <div class="del-item">
                    <div class="del-label">Total Calories</div>
                    <div class="del-value">@log.TotalCalories.ToString("N0") kcal</div>
                </div>
            </div>

            <div class="wp-dangerbox del-danger">
                <div class="wp-danger-title">Warning</div>
                <div class="wp-danger-sub">
                    Deleting this diet log will permanently remove it.
                </div>
            </div>

            <div class="del-actions">
                <button class="wp-newbtn wp-btn-danger"
                        disabled="@isDeleting"
                        @onclick="ConfirmDelete">
                    @(isDeleting ? "Deleting…" : "Delete")
                </button>

                <button class="wp-newbtn wp-btn-secondary"
                        type="button"
                        disabled="@isDeleting"
                        @onclick="@(() => Nav.NavigateTo("/dietlogs"))">
                    Cancel
                </button>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public int Id { get; set; }

    private bool isLoading = true;
    private bool isDeleting = false;
    private string? error;

    private DietLog? log;
    private string foodName = "—";

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        error = null;

        try
        {
            using var db = DbFactory.CreateDbContext();

            log = await db.DietLog
                .AsNoTracking()
                .FirstOrDefaultAsync(x => x.Id == Id);

            if (log is null)
            {
                error = "Diet log not found.";
                return;
            }

            if (log.FoodItemId.HasValue)
            {
                var food = await db.FoodItems
                    .AsNoTracking()
                    .FirstOrDefaultAsync(f => f.Id == log.FoodItemId.Value);

                if (food is not null)
                    foodName = food.Name ?? $"Food #{food.Id}";
                else
                    foodName = $"Food #{log.FoodItemId.Value}";
            }
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ConfirmDelete()
    {
        if (isDeleting) return;
        error = null;

        try
        {
            isDeleting = true;

            using var db = DbFactory.CreateDbContext();

            var tracked = await db.DietLog
                .FirstOrDefaultAsync(x => x.Id == Id);

            if (tracked is null)
            {
                error = "Diet log not found.";
                return;
            }

            db.DietLog.Remove(tracked);
            await db.SaveChangesAsync();

            Nav.NavigateTo("/dietlogs");
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            isDeleting = false;
        }
    }
}
