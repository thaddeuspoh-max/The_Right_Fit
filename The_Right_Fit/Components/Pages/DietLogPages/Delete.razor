@page "/dietlogs/delete/{Id:int}"
@rendermode InteractiveServer

@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using The_Right_Fit.Domain

@inject IDbContextFactory<The_Right_Fit.Data.The_Right_FitContext> DbFactory
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav

<PageTitle>Delete Diet Log</PageTitle>

<div class="wp">
    <div class="wp-head">
        <div>
            <h1 class="wp-title">Delete Diet Log</h1>
            <div class="wp-sub">Confirm deletion of this diet log entry.</div>
        </div>

        <NavLink class="wp-linkbtn" href="/dietlogs">Back</NavLink>
    </div>

    @if (isLoading)
    {
        <div class="wp-loading">Loading…</div>
    }
    else if (!string.IsNullOrWhiteSpace(error))
    {
        <div class="wp-empty">
            <div class="wp-empty-title">Cannot delete</div>
            <div class="wp-empty-sub">@error</div>
        </div>
    }
    else if (log is null)
    {
        <div class="wp-empty">
            <div class="wp-empty-title">Not found</div>
            <div class="wp-empty-sub">Diet log not found.</div>
        </div>
    }
    else
    {
        <div class="wp-card" style="padding:18px;">

            <div class="wp-name">Diet Log</div>

            <div class="wp-desc">
                <div><span class="wp-label">Date:</span> @log.LogDate.ToString("ddd, dd MMM yyyy")</div>
                <div><span class="wp-label">Meal:</span> @(!string.IsNullOrWhiteSpace(log.MealType) ? log.MealType : "Meal")</div>
                <div><span class="wp-label">Food:</span> @foodName</div>
            </div>

            <div class="wl-del-summary wl-del-summary-2">
                <div class="wl-del-item">
                    <div class="wl-del-label">Servings</div>
                    <div class="wl-del-value">@log.QuantityServings</div>
                </div>

                <div class="wl-del-item">
                    <div class="wl-del-label">Total Calories</div>
                    <div class="wl-del-value">@log.TotalCalories.ToString("N0") kcal</div>
                </div>
            </div>

            <div class="wp-dangerbox" style="margin-top:14px;">
                <div class="wp-danger-title">Warning</div>
                <div class="wp-danger-sub">
                    Deleting this diet log will permanently remove it.
                </div>
            </div>

            <div class="wp-actions">
                <button class="wp-newbtn wp-btn-danger"
                        disabled="@isDeleting"
                        @onclick="ConfirmDelete">
                    @(isDeleting ? "Deleting…" : "Delete")
                </button>

                <button class="wp-newbtn wp-btn-secondary"
                        type="button"
                        disabled="@isDeleting"
                        @onclick="@(() => Nav.NavigateTo("/dietlogs"))">
                    Cancel
                </button>
            </div>

        </div>
    }
</div>

@code {
    [Parameter] public int Id { get; set; }

    private bool isLoading = true;
    private bool isDeleting = false;
    private string? error;

    private DietLog? log;
    private string foodName = "—";

    private string? identityUserId;
    private bool isAdmin;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        error = null;

        try
        {
            // auth (same pattern as your Details page)
            var auth = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = auth.User;

            if (user.Identity?.IsAuthenticated != true)
            {
                Nav.NavigateTo("/Account/Login", true);
                return;
            }

            identityUserId = user.FindFirstValue(ClaimTypes.NameIdentifier);
            isAdmin = user.IsInRole("Administrator");

            using var db = DbFactory.CreateDbContext();

            log = await db.DietLog
                .AsNoTracking()
                .FirstOrDefaultAsync(x => x.Id == Id);

            if (log is null)
            {
                error = "Diet log not found.";
                return;
            }

            // ✅ ownership check (admin can delete all; users can delete own)
            if (!isAdmin && !string.Equals(log.OwnerIdentityUserId, identityUserId, StringComparison.Ordinal))
            {
                error = "You don't have access to delete this diet log.";
                log = null;
                return;
            }

            // load food name
            if (log.FoodItemId.HasValue)
            {
                var food = await db.FoodItems
                    .AsNoTracking()
                    .FirstOrDefaultAsync(f => f.Id == log.FoodItemId.Value);

                if (food is not null)
                    foodName = food.Name ?? $"Food #{food.Id}";
                else
                    foodName = $"Food #{log.FoodItemId.Value}";
            }
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ConfirmDelete()
    {
        if (isDeleting) return;
        error = null;

        try
        {
            isDeleting = true;

            using var db = DbFactory.CreateDbContext();

            var tracked = await db.DietLog
                .FirstOrDefaultAsync(x => x.Id == Id);

            if (tracked is null)
            {
                error = "Diet log not found.";
                return;
            }

            // ✅ re-check access before delete (extra safety)
            if (!isAdmin && !string.Equals(tracked.OwnerIdentityUserId, identityUserId, StringComparison.Ordinal))
            {
                error = "You don't have access to delete this diet log.";
                return;
            }

            db.DietLog.Remove(tracked);
            await db.SaveChangesAsync();

            Nav.NavigateTo("/dietlogs");
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            isDeleting = false;
        }
    }
}
