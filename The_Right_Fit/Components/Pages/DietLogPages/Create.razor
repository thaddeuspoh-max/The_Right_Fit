@page "/dietlogs/create"
@rendermode InteractiveServer

@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using The_Right_Fit.Data
@using The_Right_Fit.Domain

@inject The_Right_FitContext Db
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav

<PageTitle>Create Diet Log</PageTitle>

<div class="wp">

    <!-- HEADER -->
    <div class="wp-head">
        <div>
            <h1 class="wp-title">Create Diet Log</h1>
            <div class="wp-sub">Select a food item and servings. Calories auto-calculate.</div>
        </div>

        <NavLink class="wp-newbtn wp-btn-secondary-black" href="/dietlogs">
            Back
        </NavLink>
    </div>

    @if (!string.IsNullOrWhiteSpace(error))
    {
        <div class="wp-empty">
            <div class="wp-empty-title">Cannot create log</div>
            <div class="wp-empty-sub">@error</div>
        </div>
    }

    <EditForm Model="form" OnValidSubmit="Save" class="wp-card" style="padding:18px;">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div style="display:grid; gap:14px;">

            <!-- Log date + meal -->
            <div style="display:grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap:14px;">
                <div>
                    <div class="wp-label">Log Date</div>
                    <InputDate class="wp-input" @bind-Value="form.LogDate" />
                    <ValidationMessage For="@(() => form.LogDate)" />
                </div>

                <div>
                    <div class="wp-label">Meal Type</div>
                    <InputSelect class="wp-select" @bind-Value="form.MealType">
                        <option value="">Select…</option>
                        <option value="Breakfast">Breakfast</option>
                        <option value="Lunch">Lunch</option>
                        <option value="Dinner">Dinner</option>
                        <option value="Snack">Snack</option>
                    </InputSelect>
                    <ValidationMessage For="@(() => form.MealType)" />
                </div>
            </div>

            <!-- Food selection -->
            <div>
                <div class="wp-label">Food Item</div>
                <InputSelect class="wp-select"
                             @bind-Value="form.FoodItemId"
                             @bind-Value:after="OnFoodChanged">
                    <option value="">Select food…</option>
                    @foreach (var f in foodItems)
                    {
                        <option value="@f.Id">@f.Name</option>
                    }
                </InputSelect>

                @if (SelectedFood is not null)
                {
                    <div class="wp-sub" style="margin-top:6px;">
                        Serving: <b>@(SelectedFood.ServingSizeDescription ?? "—")</b>
                        • Calories per serving: <b>@SelectedFood.Calories.ToString("N0")</b> kcal
                    </div>
                }

                <ValidationMessage For="@(() => form.FoodItemId)" />
            </div>

            <!-- Servings + total calories -->
            <div style="display:grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap:14px;">
                <div>
                    <div class="wp-label">Servings</div>
                    <InputNumber class="wp-input"
                                 @bind-Value="form.QuantityServings"
                                 @bind-Value:after="RecalcCalories" />
                    <ValidationMessage For="@(() => form.QuantityServings)" />
                </div>

                <div>
                    <div class="wp-label">Total Calories (kcal)</div>
                    <!-- better to show read-only as plain input so Blazor doesn't fight binding -->
                    <input class="wp-input" value="@form.TotalCalories" readonly />
                    <div class="wp-sub" style="margin-top:6px;">Auto: calories per serving × servings</div>
                </div>
            </div>

            <!-- Actions -->
            <div style="display:flex; gap:10px; flex-wrap:wrap; padding-top:4px;">
                <button type="submit" class="wp-newbtn">Create Log</button>
                <NavLink class="wp-linkbtn" href="/dietlogs">Cancel</NavLink>
            </div>

        </div>
    </EditForm>

</div>

@code {
    private string? error;

    private DietLog form = new()
    {
        LogDate = DateTime.Today,
        MealType = "",
        QuantityServings = 1,
        TotalCalories = 0,
        // OwnerIdentityUserId will be set on save
        // UserId will be set on save (kept for now)
    };

    private List<FoodItems> foodItems = new();

    private FoodItems? SelectedFood =>
        form.FoodItemId.HasValue
            ? foodItems.FirstOrDefault(x => x.Id == form.FoodItemId.Value)
            : null;

    protected override async Task OnInitializedAsync()
    {
        error = null;

        // Must be logged in
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        if (auth.User.Identity?.IsAuthenticated != true)
        {
            Nav.NavigateTo("/Account/Login", true);
            return;
        }

        // Load foods
        foodItems = await Db.FoodItems
            .AsNoTracking()
            .Where(x => x.IsCustom == 0)
            .OrderBy(x => x.Name)
            .ToListAsync();

        RecalcCalories();
    }

    private void OnFoodChanged()
    {
        RecalcCalories();
    }

    private void RecalcCalories()
    {
        var food = SelectedFood;

        var servings = form.QuantityServings;
        if (servings < 0) servings = 0;

        var cps = food?.Calories ?? 0; // Calories per serving
        form.TotalCalories = (int)Math.Round(cps * servings, MidpointRounding.AwayFromZero);
    }

    private async Task Save()
    {
        error = null;

        // Must select a food item (since you said don't add custom foodname)
        if (!form.FoodItemId.HasValue)
        {
            error = "Please select a food item.";
            return;
        }

        // Ensure calories correct
        RecalcCalories();

        // Get logged-in Identity user id
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = auth.User;

        if (user.Identity?.IsAuthenticated != true)
        {
            Nav.NavigateTo("/Account/Login", true);
            return;
        }

        var uid = user.FindFirstValue(ClaimTypes.NameIdentifier);
        if (string.IsNullOrWhiteSpace(uid))
        {
            error = "Cannot read your user id.";
            return;
        }

        // ✅ THIS is what stops cross-user leakage
        form.OwnerIdentityUserId = uid;

        // ✅ If you still have int UserId in your entity, you MUST set something.
        // Best fix: remove UserId from DietLog/WorkoutLog and only use OwnerIdentityUserId.
        // For now: keep placeholder so insert doesn't fail.
        if (form.UserId == 0)
            form.UserId = 1;

        Db.DietLog.Add(form);
        await Db.SaveChangesAsync();

        Nav.NavigateTo("/dietlogs");
    }
}
