@page "/dietlogs"
@rendermode InteractiveServer

@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using The_Right_Fit.Data
@using The_Right_Fit.Domain

@inject The_Right_FitContext Db
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav

<PageTitle>Diet Logs</PageTitle>

<div class="wp">

    <!-- HEADER -->
    <div class="wp-head">
        <div>
            <h1 class="wp-title">Diet Logs</h1>
            <div class="wp-sub">Track what you eat, meal type, and calories.</div>
        </div>

        <NavLink class="wp-newbtn" href="/dietlogs/create">
            <span class="wp-plus">+</span>
            New Log
        </NavLink>
    </div>

    <!-- FILTERS -->
    <div class="wp-card wl-filters">

        <div class="wl-filters-head">
            <div>
                <div class="wl-filters-title">Filters</div>
                <div class="wl-filters-sub">Narrow down logs by date, meal, calories, or food.</div>
            </div>

            <button class="wp-linkbtn" @onclick="ResetFilters">Reset</button>
        </div>

        <div class="wl-filters-grid">

            <div class="wl-filter">
                <div class="wp-label">From</div>
                <InputDate class="wp-input" @bind-Value="fromDate" />
            </div>

            <div class="wl-filter">
                <div class="wp-label">To</div>
                <InputDate class="wp-input" @bind-Value="toDate" />
            </div>

            <div class="wl-filter">
                <div class="wp-label">Meal Type</div>
                <select class="wp-select" @bind="mealType">
                    <option value="">Any</option>
                    <option value="Breakfast">Breakfast</option>
                    <option value="Lunch">Lunch</option>
                    <option value="Dinner">Dinner</option>
                    <option value="Snack">Snack</option>
                </select>
            </div>

            <div class="wl-filter">
                <div class="wp-label">Min Calories</div>
                <select class="wp-select" @bind="minCaloriesText">
                    <option value="">Any</option>
                    <option value="200">200+</option>
                    <option value="400">400+</option>
                    <option value="600">600+</option>
                    <option value="800">800+</option>
                    <option value="1000">1000+</option>
                </select>
            </div>

            <div class="wl-filter wl-filter-span2">
                <div class="wp-label">Search Food</div>
                <div class="wp-searchbox">
                    <span class="wp-searchicon">🔍</span>
                    <input class="wp-input"
                           placeholder="Chicken rice, oats..."
                           @bind="search"
                           @bind:event="oninput" />
                </div>
            </div>

        </div>
    </div>

    <!-- CALORIE TRACKER -->
    <div class="wp-card dl-tracker">
        <div class="dl-tracker-top">
            <div>
                <div class="dl-tracker-title">Calorie Tracker</div>
                <div class="dl-tracker-sub">Based on current filters</div>
            </div>

            <div class="dl-target">
                <div class="wp-label">Daily Target (kcal)</div>
                <InputNumber class="wp-input" @bind-Value="dailyTargetKcal" />
            </div>
        </div>

        <div class="dl-metrics">
            <div class="dl-metric">
                <div class="dl-metric-label">Total Calories</div>
                <div class="dl-metric-value">@TotalCaloriesFiltered</div>
            </div>

            <div class="dl-metric">
                <div class="dl-metric-label">Days</div>
                <div class="dl-metric-value">@DaysInRange</div>
            </div>

            <div class="dl-metric">
                <div class="dl-metric-label">Daily Avg</div>
                <div class="dl-metric-value">@DailyAverageCalories.ToString("0")</div>
            </div>
        </div>

        <div class="dl-bar">
            <div class="dl-barfill" style="width:@($"{ProgressPercent:0.##}%")"></div>
        </div>
    </div>

    <!-- CONTENT -->
    @if (loading)
    {
        <div class="wp-loading">Loading diet logs…</div>
    }
    else if (FilteredLogs.Count == 0)
    {
        <div class="wp-empty">
            <div class="wp-empty-title">No diet logs found</div>
            <div class="wp-empty-sub">Try adjusting filters or create a new log.</div>
        </div>
    }
    else
    {
        <div class="wl-grid">
            @foreach (var x in FilteredLogs)
            {
                <div class="wp-card wl-card">

                    <div class="wl-cardtop">
                        <span class="wl-tag">@x.MealType</span>
                        <span class="wl-date">@x.LogDate.ToString("dd MMM yyyy")</span>
                    </div>

                    <div class="wl-main">
                        <div class="wl-duration">
                            🍽 @FoodLabel(x)
                        </div>

                        <div class="dl-chips">
                            <span class="dl-chip">@x.QuantityServings servings</span>
                            <span class="dl-chip">@x.TotalCalories kcal</span>
                        </div>
                    </div>

                    <div class="wl-cardbottom">
                        <NavLink class="wp-newbtn wl-btn-sm"
                                 href="@($"/dietlogs/details/{x.Id}")">
                            View
                        </NavLink>

                        <div class="wl-actions">
                            <NavLink class="wp-linkbtn"
                                     href="@($"/dietlogs/edit/{x.Id}")">
                                Edit
                            </NavLink>

                            <NavLink class="wp-linkbtn wp-linkbtn-danger"
                                     href="@($"/dietlogs/delete/{x.Id}")">
                                Delete
                            </NavLink>
                        </div>
                    </div>

                </div>
            }
        </div>
    }

</div>

@code {
    private bool loading = true;
    private string? identityUserId;

    private List<DietLog> allLogs = new();
    private Dictionary<int, string> foodNameById = new();

    // filters
    private DateTime? fromDate;
    private DateTime? toDate;
    private string? mealType = "";
    private string? minCaloriesText = "";
    private string search = "";

    // tracker
    private int dailyTargetKcal = 2000;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = auth.User;

        if (user.Identity?.IsAuthenticated != true)
        {
            Nav.NavigateTo("/Account/Login", true);
            return;
        }

        identityUserId = user.FindFirstValue(ClaimTypes.NameIdentifier);

        allLogs = await Db.DietLog
            .AsNoTracking()
            .Where(x => x.OwnerIdentityUserId == identityUserId) // 🔐 FIX
            .OrderByDescending(x => x.LogDate)
            .ToListAsync();

        var foodIds = allLogs
            .Where(x => x.FoodItemId.HasValue)
            .Select(x => x.FoodItemId!.Value)
            .Distinct()
            .ToList();

        if (foodIds.Count > 0)
        {
            foodNameById = await Db.FoodItems
                .AsNoTracking()
                .Where(f => foodIds.Contains(f.Id))
                .ToDictionaryAsync(f => f.Id, f => f.Name!);
        }

        loading = false;
    }

    private List<DietLog> FilteredLogs
    {
        get
        {
            IEnumerable<DietLog> q = allLogs;

            if (fromDate.HasValue)
                q = q.Where(x => x.LogDate >= fromDate.Value.Date);

            if (toDate.HasValue)
                q = q.Where(x => x.LogDate <= toDate.Value.Date.AddDays(1).AddTicks(-1));

            if (!string.IsNullOrWhiteSpace(mealType))
                q = q.Where(x => x.MealType == mealType);

            if (int.TryParse(minCaloriesText, out var minC))
                q = q.Where(x => x.TotalCalories >= minC);

            if (!string.IsNullOrWhiteSpace(search))
            {
                q = q.Where(x =>
                    (x.CustomFoodName ?? "").Contains(search, StringComparison.OrdinalIgnoreCase) ||
                    (x.FoodItemId.HasValue &&
                     foodNameById.TryGetValue(x.FoodItemId.Value, out var n) &&
                     n.Contains(search, StringComparison.OrdinalIgnoreCase))
                );
            }

            return q.ToList();
        }
    }

    private int TotalCaloriesFiltered => FilteredLogs.Sum(x => x.TotalCalories);

    private int DaysInRange =>
        FilteredLogs.Select(x => x.LogDate.Date).Distinct().Count();

    private double DailyAverageCalories =>
        DaysInRange == 0 ? 0 : (double)TotalCaloriesFiltered / DaysInRange;

    private double ProgressPercent =>
        dailyTargetKcal == 0 ? 0 : Math.Min(100, (DailyAverageCalories / dailyTargetKcal) * 100);

    private string FoodLabel(DietLog x)
    {
        if (x.FoodItemId.HasValue &&
            foodNameById.TryGetValue(x.FoodItemId.Value, out var name))
            return name;

        return x.CustomFoodName ?? "Food";
    }

    private void ResetFilters()
    {
        fromDate = null;
        toDate = null;
        mealType = "";
        minCaloriesText = "";
        search = "";
    }
}
