@page "/workoutplans/edit/{Id:int}"
@using Microsoft.EntityFrameworkCore
@using The_Right_Fit.Data
@using The_Right_Fit.Domain
@inject The_Right_FitContext Db
@inject NavigationManager Nav

<PageTitle>Edit Workout Plan</PageTitle>

<div class="wp">
    <div class="wp-head">
        <div>
            <h1 class="wp-title">Edit Plan</h1>
            <div class="wp-sub">Update workout plan details.</div>
        </div>

        <NavLink class="wp-newbtn" href="/workoutplans">Back</NavLink>
    </div>

    @if (plan == null)
    {
        <div class="wp-loading">Loading…</div>
    }
    else
    {
        <div class="wp-card" style="padding:18px;">
            <EditForm Model="plan" OnValidSubmit="Save">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="mb-3">
                    <label class="wp-label">Plan Name</label>
                    <InputText class="wp-select" @bind-Value="plan.PlanName" />
                </div>

                <div class="mb-3">
                    <label class="wp-label">Goal Type</label>
                    <InputText class="wp-select" @bind-Value="plan.GoalType" />
                </div>

                <div class="mb-3">
                    <label class="wp-label">Difficulty Level</label>
                    <InputSelect class="wp-select" @bind-Value="plan.DifficultyLevel">
                        <option value="">Select</option>
                        <option>Beginner</option>
                        <option>Intermediate</option>
                        <option>Advanced</option>
                    </InputSelect>
                </div>

                <div class="mb-3">
                    <label class="wp-label">Duration (Weeks)</label>
                    <InputNumber class="wp-select" @bind-Value="plan.DurationWeeks" />
                </div>

                <div class="mb-3">
                    <label class="wp-label">UserId (optional)</label>
                    <InputNumber class="wp-select" @bind-Value="plan.UserId" />
                </div>

              

                <button class="wp-newbtn" type="submit">Save</button>
            </EditForm>
        </div>
    }
</div>

@code {
    [Parameter] public int Id { get; set; }
    private WorkoutPlan? plan;

    protected override async Task OnInitializedAsync()
    {
        plan = await Db.WorkoutPlan.FirstOrDefaultAsync(x => x.Id == Id);
    }

    private async Task Save()
    {
        if (plan is null) return;

        Db.WorkoutPlan.Update(plan);
        await Db.SaveChangesAsync();
        Nav.NavigateTo("/workoutplans");
    }
}
