@page "/workoutplans/edit/{Id:int}"
@rendermode InteractiveServer

@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using The_Right_Fit.Data
@using The_Right_Fit.Domain

@inject The_Right_FitContext Db
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Edit Workout Plan</PageTitle>

<div class="wp">

    <div class="wp-head">
        <div>
            <h1 class="wp-title">Edit Plan</h1>
            <div class="wp-sub">Update plan details and assign exercises per day.</div>
        </div>

        <NavLink class="wp-linkbtn" href="/workoutplans">Back</NavLink>
    </div>

    @if (isLoading)
    {
        <div class="wp-loading">Loading…</div>
    }
    else if (!string.IsNullOrWhiteSpace(error))
    {
        <div class="wp-empty">
            <div class="wp-empty-title">Cannot edit</div>
            <div class="wp-empty-sub">@error</div>
        </div>
    }
    else if (plan == null)
    {
        <div class="wp-loading">Plan not found.</div>
    }
    else
    {
        <EditForm Model="form" OnValidSubmit="Save">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="wp-card" style="padding:18px;">

                <!-- BASIC INFO -->
                <div style="display:grid; gap:12px;">
                    <div>
                        <div class="wp-label">Plan Name</div>
                        <input class="wp-input" @bind="form.PlanName" />
                    </div>

                    <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px;">
                        <div>
                            <div class="wp-label">Goal</div>
                            <input class="wp-input" @bind="form.GoalType" />
                        </div>

                        <div>
                            <div class="wp-label">Difficulty</div>
                            <select class="wp-select" @bind="form.DifficultyLevel">
                                <option>Beginner</option>
                                <option>Intermediate</option>
                                <option>Advanced</option>
                            </select>
                        </div>
                    </div>

                    <div style="max-width:200px;">
                        <div class="wp-label">Duration (weeks)</div>
                        <input class="wp-input" type="number" min="1" @bind="form.DurationWeeks" />
                    </div>
                </div>

                <hr style="margin:16px 0; opacity:.2;" />

                <!-- DAY SELECTOR (fixed capture bug) -->
                <div style="display:flex; gap:10px; flex-wrap:wrap; margin-bottom:12px;">
                    @for (int d = 1; d <= 7; d++)
                    {
                        var day = d;

                        <button type="button"
                                class="wp-newbtn"
                                style="background:@(day == selectedDay ? "var(--trf-primary)" : "rgba(15,23,42,.06)");
                                               color:@(day == selectedDay ? "#fff" : "#0f172a");
                                               box-shadow:none;"
                                @onclick="@(() => selectedDay = day)">
                            @DayName(day)
                        </button>
                    }
                </div>

                <!-- CURRENT DAY EXERCISES -->
                <div>
                    <div class="wp-label">Exercises for @DayName(selectedDay)</div>

                    @if (DayRows(selectedDay).Count == 0)
                    {
                        <div class="wp-sub" style="margin-top:8px;">No exercises added for this day.</div>
                    }
                    else
                    {
                        @foreach (var row in DayRows(selectedDay))
                        {
                            <div @key="@($"{selectedDay}-{row.ExerciseId}")"
                                 style="display:grid;
                                                    grid-template-columns: 1.5fr .5fr .5fr .6fr;
                                                    gap:10px;
                                                    padding:12px;
                                                    margin-top:10px;
                                                    border:1px solid rgba(15,23,42,.1);
                                                    border-radius:12px;">

                                <div>
                                    <div class="wp-label">Exercise</div>
                                    <strong>@row.ExerciseName</strong>
                                </div>

                                <div>
                                    <div class="wp-label">Sets</div>
                                    <input class="wp-input" type="number" min="1" @bind="row.Sets" />
                                </div>

                                <div>
                                    <div class="wp-label">Reps</div>
                                    <input class="wp-input" type="number" min="1" @bind="row.Reps" />
                                </div>

                                <div style="display:flex; align-items:flex-end;">
                                    <button type="button"
                                            class="wp-newbtn"
                                            style="background:rgba(15,23,42,.06); color:#0f172a; box-shadow:none;"
                                            @onclick="@(() => Remove(selectedDay, row.ExerciseId))">
                                        Remove
                                    </button>
                                </div>
                            </div>
                        }
                    }
                </div>

                <hr style="margin:16px 0; opacity:.2;" />

                <!-- ADD EXERCISES (with search + filter like your old file) -->
                <div style="display:flex; justify-content:space-between; align-items:flex-end; gap:12px; flex-wrap:wrap;">
                    <div>
                        <div class="wp-label">Add exercise to @DayName(selectedDay)</div>
                        <div class="wp-sub">Showing @FilteredExercises.Count of @allExercises.Count</div>
                    </div>
                </div>

                <div style="display:flex; gap:10px; flex-wrap:wrap; margin-top:10px;">
                    <div style="flex:1; min-width:220px;">
                        <div class="wp-label">Search</div>
                        <input class="wp-input"
                               placeholder="Search exercises..."
                               @bind="exerciseSearch"
                               @bind:event="oninput" />
                    </div>

                    <div style="min-width:220px;">
                        <div class="wp-label">Muscle Group</div>
                        <select class="wp-select" @bind="selectedMuscleGroup">
                            <option value="">All muscle groups</option>
                            @foreach (var mg in muscleGroups)
                            {
                                <option value="@mg">@mg</option>
                            }
                        </select>
                    </div>
                </div>

                @foreach (var ex in FilteredExercises)
                {
                    bool added = DayRows(selectedDay).Any(x => x.ExerciseId == ex.Id);

                    <div @key="@($"picker-{selectedDay}-{ex.Id}")"
                         style="display:flex; justify-content:space-between;
                                        padding:10px; margin-top:8px;
                                        border:1px solid rgba(15,23,42,.08);
                                        border-radius:10px;">

                        <span>
                            @ex.ExerciseName
                            @if (!string.IsNullOrWhiteSpace(GetMuscleGroup(ex)))
                            {
                                <span style="opacity:.7;"> (@GetMuscleGroup(ex))</span>
                            }
                        </span>

                        <button type="button"
                                class="wp-newbtn"
                                disabled="@added"
                                @onclick="@(() => Add(selectedDay, ex))">
                            @(added ? "Added" : "Add")
                        </button>
                    </div>
                }

                <div style="display:flex; gap:10px; margin-top:18px;">
                    <button class="wp-newbtn" type="submit">Save Changes</button>
                    <button type="button"
                            class="wp-newbtn"
                            style="background:rgba(15,23,42,.06); color:#0f172a;"
                            @onclick="@(() => Nav.NavigateTo("/workoutplans"))">
                        Cancel
                    </button>
                </div>

            </div>
        </EditForm>
    }
</div>

@code {

    [Parameter] public int Id { get; set; }

    private WorkoutPlan? plan;
    private bool isLoading = true;
    private string? error;

    private int selectedDay = 1;

    // Auth
    private string? identityUserId;
    private bool isAdmin;

    private PlanForm form = new()
    {
        DifficultyLevel = "Beginner",
        DurationWeeks = 4
    };

    private List<Exercise> allExercises = new();
    private Dictionary<int, List<DayRow>> dayMap = new();

    // Search + filter
    private string exerciseSearch = "";
    private string selectedMuscleGroup = "";
    private List<string> muscleGroups = new();

    private class PlanForm
    {
        public string? PlanName { get; set; }
        public string? GoalType { get; set; }
        public string DifficultyLevel { get; set; } = "Beginner";
        public int DurationWeeks { get; set; } = 4;
    }

    private class DayRow
    {
        public int ExerciseId { get; set; }
        public string ExerciseName { get; set; } = "";
        public int Sets { get; set; } = 3;
        public int Reps { get; set; } = 10;
    }

    private static bool IsValidDay(int d) => d >= 1 && d <= 7;

    private List<DayRow> DayRows(int d)
    {
        if (!IsValidDay(d))
            return new List<DayRow>();

        if (!dayMap.ContainsKey(d))
            dayMap[d] = new();

        return dayMap[d];
    }

    // Works even if your Exercise property name differs
    private static string? GetMuscleGroup(Exercise ex)
        => ex.GetType().GetProperty("MuscleGroup")?.GetValue(ex) as string;

    private List<Exercise> FilteredExercises
    {
        get
        {
            IEnumerable<Exercise> q = allExercises;

            if (!string.IsNullOrWhiteSpace(selectedMuscleGroup))
            {
                var mg = selectedMuscleGroup.Trim();
                q = q.Where(e => (GetMuscleGroup(e) ?? "").Trim()
                    .Equals(mg, StringComparison.OrdinalIgnoreCase));
            }

            if (!string.IsNullOrWhiteSpace(exerciseSearch))
            {
                var s = exerciseSearch.Trim();
                q = q.Where(e => (e.ExerciseName ?? "")
                    .Contains(s, StringComparison.OrdinalIgnoreCase));
            }

            return q.ToList();
        }
    }

    private void Add(int d, Exercise ex)
    {
        if (!IsValidDay(d)) return;
        if (DayRows(d).Any(x => x.ExerciseId == ex.Id)) return;

        DayRows(d).Add(new DayRow
        {
            ExerciseId = ex.Id,
            ExerciseName = ex.ExerciseName,
            Sets = 3,
            Reps = 10
        });
    }

    private void Remove(int d, int exId)
    {
        if (!IsValidDay(d)) return;

        var row = DayRows(d).FirstOrDefault(x => x.ExerciseId == exId);
        if (row != null)
            DayRows(d).Remove(row);
    }

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;

        // Auth
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = auth.User;

        if (user.Identity?.IsAuthenticated != true)
        {
            Nav.NavigateTo("/Identity/Account/Login", true);
            return;
        }

        identityUserId = user.FindFirstValue(ClaimTypes.NameIdentifier);
        isAdmin = user.IsInRole("Administrator");

        // Load plan
        plan = await Db.WorkoutPlan.FirstOrDefaultAsync(x => x.Id == Id);
        if (plan == null)
        {
            error = "Workout plan not found.";
            isLoading = false;
            return;
        }

        // Authorization rules
        if (!string.IsNullOrWhiteSpace(plan.OwnerIdentityUserId))
        {
            if (!isAdmin && plan.OwnerIdentityUserId != identityUserId)
            {
                error = "You are not allowed to edit this plan.";
                plan = null;
                isLoading = false;
                return;
            }
        }
        else
        {
            if (!isAdmin)
            {
                error = "Only admins can edit library plans.";
                plan = null;
                isLoading = false;
                return;
            }
        }

        // Load exercises
        allExercises = await Db.Exercise
            .OrderBy(x => x.ExerciseName)
            .ToListAsync();

        // Muscle group dropdown
        muscleGroups = allExercises
            .Select(e => (GetMuscleGroup(e) ?? "").Trim())
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(x => x)
            .ToList();

        // Init day map (1..7)
        dayMap.Clear();
        for (int d = 1; d <= 7; d++)
            dayMap[d] = new();

        selectedDay = 1;

        // Pre-fill form from plan
        form.PlanName = plan.PlanName;
        form.GoalType = plan.GoalType;
        form.DifficultyLevel = string.IsNullOrWhiteSpace(plan.DifficultyLevel) ? "Beginner" : plan.DifficultyLevel!;
        form.DurationWeeks = plan.DurationWeeks;

        // Load existing plan-exercises (day/sets/reps)
        var existingLinks = await Db.WorkoutPlanExercise
            .Where(x => x.WorkoutPlanId == Id)
            .ToListAsync();

        var nameMap = allExercises.ToDictionary(e => e.Id, e => e.ExerciseName);

        foreach (var link in existingLinks)
        {
            var d = link.DayOfWeek;
            if (!IsValidDay(d)) continue;

            dayMap[d].Add(new DayRow
            {
                ExerciseId = link.ExerciseId,
                ExerciseName = nameMap.TryGetValue(link.ExerciseId, out var n) ? n : $"Exercise #{link.ExerciseId}",
                Sets = link.Sets,
                Reps = link.Reps
            });
        }

        isLoading = false;
    }

    private async Task Save()
    {
        if (plan == null) return;

        // Server-side auth recheck
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = auth.User;

        if (user.Identity?.IsAuthenticated != true)
        {
            Nav.NavigateTo("/Identity/Account/Login", true);
            return;
        }

        var currentIdentityId = user.FindFirstValue(ClaimTypes.NameIdentifier);
        var currentIsAdmin = user.IsInRole("Administrator");

        // Reload plan from DB to verify permission
        var dbPlan = await Db.WorkoutPlan.FirstOrDefaultAsync(x => x.Id == Id);
        if (dbPlan == null)
        {
            error = "Workout plan not found.";
            return;
        }

        if (!string.IsNullOrWhiteSpace(dbPlan.OwnerIdentityUserId))
        {
            if (!currentIsAdmin && dbPlan.OwnerIdentityUserId != currentIdentityId)
            {
                error = "You are not allowed to save changes for this plan.";
                return;
            }
        }
        else
        {
            if (!currentIsAdmin)
            {
                error = "Only admins can edit library plans.";
                return;
            }
        }

        // Update plan fields
        dbPlan.PlanName = form.PlanName;
        dbPlan.GoalType = form.GoalType;
        dbPlan.DifficultyLevel = form.DifficultyLevel;
        dbPlan.DurationWeeks = form.DurationWeeks;
        dbPlan.DateUpdated = DateTime.Now;

        // Remove existing links
        var oldLinks = await Db.WorkoutPlanExercise
            .Where(x => x.WorkoutPlanId == Id)
            .ToListAsync();

        if (oldLinks.Any())
            Db.WorkoutPlanExercise.RemoveRange(oldLinks);

        // Re-add from dayMap (save ONLY 1..7)
        var newLinks = new List<WorkoutPlanExercise>();

        for (int d = 1; d <= 7; d++)
        {
            foreach (var r in dayMap[d])
            {
                newLinks.Add(new WorkoutPlanExercise
                {
                    WorkoutPlanId = Id,
                    ExerciseId = r.ExerciseId,
                    DayOfWeek = d,
                    Sets = r.Sets,
                    Reps = r.Reps
                });
            }
        }

        if (newLinks.Any())
            await Db.WorkoutPlanExercise.AddRangeAsync(newLinks);

        await Db.SaveChangesAsync();
        Nav.NavigateTo("/workoutplans");
    }

    private static string DayName(int d) => d switch
    {
        1 => "Monday",
        2 => "Tuesday",
        3 => "Wednesday",
        4 => "Thursday",
        5 => "Friday",
        6 => "Saturday",
        7 => "Sunday",
        _ => "Day"
    };
}
