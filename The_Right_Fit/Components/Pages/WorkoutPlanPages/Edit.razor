@page "/workoutplans/edit/{Id:int}"
@rendermode InteractiveServer

@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using The_Right_Fit.Data
@using The_Right_Fit.Domain

@inject The_Right_FitContext Db
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Edit Workout Plan</PageTitle>

<div class="wp">
    <div class="wp-head">
        <div>
            <h1 class="wp-title">Edit Plan</h1>
            <div class="wp-sub">Update plan details and included exercises.</div>
        </div>

        <NavLink class="wp-newbtn" href="/workoutplans">Back</NavLink>
    </div>

    @if (isLoading)
    {
        <div class="wp-loading">Loading…</div>
    }
    else if (!string.IsNullOrWhiteSpace(error))
    {
        <div class="wp-empty">
            <div class="wp-empty-title">Cannot edit</div>
            <div class="wp-empty-sub">@error</div>
        </div>
    }
    else if (plan == null)
    {
        <div class="wp-loading">Plan not found.</div>
    }
    else
    {
        <EditForm Model="plan" OnValidSubmit="Save" FormName="EditWorkoutPlan">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="wp-card" style="padding:18px;">

                <!-- Plan fields -->
                <div style="display:grid; gap:12px;">
                    <div>
                        <div class="wp-label">Plan Name</div>
                        <input class="wp-input"
                               @bind="plan.PlanName"
                               @bind:event="oninput" />
                    </div>

                    <div style="display:grid; grid-template-columns: 1fr 1fr; gap:12px;">
                        <div>
                            <div class="wp-label">Goal</div>
                            <input class="wp-input"
                                   @bind="plan.GoalType"
                                   @bind:event="oninput" />
                        </div>

                        <div>
                            <div class="wp-label">Difficulty</div>
                            <select class="wp-select" @bind="plan.DifficultyLevel">
                                <option value="">Select…</option>
                                <option value="Beginner">Beginner</option>
                                <option value="Intermediate">Intermediate</option>
                                <option value="Advanced">Advanced</option>
                            </select>
                        </div>
                    </div>

                    <div>
                        <div class="wp-label">Duration (weeks)</div>
                        <input class="wp-input" type="number"
                               @bind="plan.DurationWeeks"
                               @bind:event="oninput" />
                    </div>
                </div>

                <hr style="margin:16px 0; opacity:.2;" />

                <!-- Exercises picker -->
                <div>
                    <div class="wp-label" style="margin-bottom:8px;">Exercises in this plan</div>

                    @if (allExercises.Count == 0)
                    {
                        <div class="wp-sub">No exercises found in the database yet.</div>
                    }
                    else
                    {
                        <!-- Search + Muscle group filter -->
                        <div style="display:grid; grid-template-columns: 2fr 1fr; gap:12px; margin-bottom:12px;">
                            <div class="wp-searchbox">
                                <span class="wp-searchicon">🔍</span>
                                <input class="wp-input"
                                       placeholder="Search exercises..."
                                       @bind="exerciseSearch"
                                       @bind:event="oninput" />
                            </div>

                            <select class="wp-select" @bind="selectedMuscleGroup">
                                <option value="">All muscle groups</option>
                                @foreach (var mg in muscleGroups)
                                {
                                    <option value="@mg">@mg</option>
                                }
                            </select>
                        </div>

                        <div class="wp-sub" style="margin-bottom:8px;">
                            Showing @FilteredExercises.Count of @allExercises.Count exercises
                        </div>

                        <div style="display:grid; gap:8px; max-height:320px; overflow:auto;">
                            @foreach (var ex in FilteredExercises)
                            {
                                <label style="display:flex; gap:10px; align-items:center;" @key="ex.Id">
                                    <input type="checkbox" @bind="checkedMap[ex.Id]" />
                                    <span>
                                        @ex.ExerciseName
                                        @if (!string.IsNullOrWhiteSpace(GetMuscleGroup(ex)))
                                        {
                                            <span class="wp-sub" style="margin-left:8px;">
                                                (@GetMuscleGroup(ex))
                                            </span>
                                        }
                                    </span>
                                </label>
                            }
                        </div>
                    }
                </div>

                <div style="display:flex; gap:10px; margin-top:16px;">
                    <button class="wp-newbtn" type="submit">Save Changes</button>

                    <button class="wp-newbtn"
                            type="button"
                            style="background:rgba(15,23,42,.06); color:#0f172a; border-color:rgba(15,23,42,.10);"
                            @onclick="@(() => Nav.NavigateTo("/workoutplans"))">
                        Cancel
                    </button>
                </div>

            </div>
        </EditForm>
    }
</div>

@code {
    [Parameter] public int Id { get; set; }

    private WorkoutPlan? plan;
    private bool isLoading = true;
    private string? error;

    // Auth
    private string? identityUserId;
    private bool isAdmin;

    private List<Exercise> allExercises = new();

    // checkbox binding that always works
    private Dictionary<int, bool> checkedMap = new();

    // Search + filter
    private string exerciseSearch = "";
    private string selectedMuscleGroup = "";
    private List<string> muscleGroups = new();

    // If your Exercise property name isn't MuscleGroup, change this helper.
    private static string? GetMuscleGroup(Exercise ex)
        => ex.GetType().GetProperty("MuscleGroup")?.GetValue(ex) as string;

    private List<Exercise> FilteredExercises
    {
        get
        {
            IEnumerable<Exercise> q = allExercises;

            if (!string.IsNullOrWhiteSpace(selectedMuscleGroup))
            {
                var mg = selectedMuscleGroup.Trim();
                q = q.Where(e => (GetMuscleGroup(e) ?? "").Trim()
                    .Equals(mg, StringComparison.OrdinalIgnoreCase));
            }

            if (!string.IsNullOrWhiteSpace(exerciseSearch))
            {
                var s = exerciseSearch.Trim();
                q = q.Where(e => (e.ExerciseName ?? "")
                    .Contains(s, StringComparison.OrdinalIgnoreCase));
            }

            return q.ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;

        // ✅ Auth
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = auth.User;

        if (user.Identity?.IsAuthenticated != true)
        {
            Nav.NavigateTo("/Identity/Account/Login", true);
            return;
        }

        identityUserId = user.FindFirstValue(ClaimTypes.NameIdentifier);
        isAdmin = user.IsInRole("Administrator");

        // Load plan
        plan = await Db.WorkoutPlan.FirstOrDefaultAsync(x => x.Id == Id);
        if (plan == null)
        {
            error = "Workout plan not found.";
            isLoading = false;
            return;
        }

        // ✅ Authorization rules
        // - If plan has OwnerIdentityUserId: owner OR admin can edit
        // - If plan is seeded/library (OwnerIdentityUserId is null/empty): admin only
        if (!string.IsNullOrWhiteSpace(plan.OwnerIdentityUserId))
        {
            if (!isAdmin && plan.OwnerIdentityUserId != identityUserId)
            {
                error = "You are not allowed to edit this plan.";
                plan = null;
                isLoading = false;
                return;
            }
        }
        else
        {
            if (!isAdmin)
            {
                error = "Only admins can edit library plans.";
                plan = null;
                isLoading = false;
                return;
            }
        }

        // Load exercises
        allExercises = await Db.Exercise
            .OrderBy(e => e.ExerciseName)
            .ToListAsync();

        // Existing selected exercise ids
        var existingIds = await Db.WorkoutPlanExercise
            .Where(x => x.WorkoutPlanId == Id)
            .Select(x => x.ExerciseId)
            .ToListAsync();

        // Init checkbox dictionary for ALL exercises
        checkedMap = allExercises.ToDictionary(
            e => e.Id,
            e => existingIds.Contains(e.Id)
        );

        // Muscle group dropdown
        muscleGroups = allExercises
            .Select(e => (GetMuscleGroup(e) ?? "").Trim())
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(x => x)
            .ToList();

        isLoading = false;
    }

    private async Task Save()
    {
        if (plan == null) return;

        // ✅ Server-side auth recheck (blocks URL tampering / manual POST)
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = auth.User;

        if (user.Identity?.IsAuthenticated != true)
        {
            Nav.NavigateTo("/Identity/Account/Login", true);
            return;
        }

        var currentIdentityId = user.FindFirstValue(ClaimTypes.NameIdentifier);
        var currentIsAdmin = user.IsInRole("Administrator");

        // Reload the plan from DB to verify permission
        var dbPlan = await Db.WorkoutPlan.FirstOrDefaultAsync(x => x.Id == Id);
        if (dbPlan == null)
        {
            error = "Workout plan not found.";
            return;
        }

        if (!string.IsNullOrWhiteSpace(dbPlan.OwnerIdentityUserId))
        {
            if (!currentIsAdmin && dbPlan.OwnerIdentityUserId != currentIdentityId)
            {
                error = "You are not allowed to save changes for this plan.";
                return;
            }
        }
        else
        {
            if (!currentIsAdmin)
            {
                error = "Only admins can edit library plans.";
                return;
            }
        }

        // Update fields
        dbPlan.PlanName = plan.PlanName;
        dbPlan.GoalType = plan.GoalType;
        dbPlan.DifficultyLevel = plan.DifficultyLevel;
        dbPlan.DurationWeeks = plan.DurationWeeks;
        dbPlan.DateUpdated = DateTime.Now;

        // Selected ids from checkbox map
        var selectedIds = checkedMap
            .Where(kv => kv.Value)
            .Select(kv => kv.Key)
            .ToHashSet();

        // Sync join table
        var links = await Db.WorkoutPlanExercise
            .Where(x => x.WorkoutPlanId == Id)
            .ToListAsync();

        var existingIds = links.Select(x => x.ExerciseId).ToHashSet();

        var toRemove = links.Where(x => !selectedIds.Contains(x.ExerciseId)).ToList();
        if (toRemove.Any())
            Db.WorkoutPlanExercise.RemoveRange(toRemove);

        var toAdd = selectedIds
            .Where(exId => !existingIds.Contains(exId))
            .Select(exId => new WorkoutPlanExercise
            {
                WorkoutPlanId = Id,
                ExerciseId = exId
            })
            .ToList();

        if (toAdd.Any())
            await Db.WorkoutPlanExercise.AddRangeAsync(toAdd);

        await Db.SaveChangesAsync();
        Nav.NavigateTo("/workoutplans");
    }
}
