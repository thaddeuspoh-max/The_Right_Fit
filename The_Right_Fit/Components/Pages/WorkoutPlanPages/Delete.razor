@page "/workoutplans/delete/{Id:int}"
@rendermode InteractiveServer

@using Microsoft.EntityFrameworkCore
@using The_Right_Fit.Data
@using The_Right_Fit.Domain

@inject The_Right_FitContext Db
@inject NavigationManager Nav

<PageTitle>Delete Workout Plan</PageTitle>

<div class="wp">
    <div class="wp-head">
        <div>
            <h1 class="wp-title">Delete Plan</h1>
            <div class="wp-sub">This action cannot be undone.</div>
        </div>

        
    </div>

    @if (isLoading)
    {
        <div class="wp-loading">Loading…</div>
    }
    else if (!string.IsNullOrWhiteSpace(error))
    {
        <div class="wp-empty">
            <div class="wp-empty-title">Cannot delete</div>
            <div class="wp-empty-sub">@error</div>
        </div>
    }
    else if (plan == null)
    {
        <div class="wp-loading">Plan not found.</div>
    }
    else
    {
        <div class="wp-card" style="padding:18px;">
            <div class="wp-name">@Safe(plan.PlanName, "Untitled Plan")</div>

            <div class="wp-desc">
                <div><strong>Goal:</strong> @Safe(plan.GoalType, "—")</div>
                <div><strong>Difficulty:</strong> @Safe(plan.DifficultyLevel, "—")</div>
                <div><strong>Duration:</strong> @plan.DurationWeeks weeks</div>
            </div>

            <div class="wp-dangerbox">
                <div class="wp-danger-title">Warning</div>
                <div class="wp-danger-sub">
                    Deleting this plan will permanently remove it and its linked exercises.
                </div>
            </div>

            <div class="wp-actions">
                <button class="wp-newbtn wp-btn-danger" @onclick="ConfirmDelete">
                    Delete
                </button>

                <button class="wp-newbtn wp-btn-secondary"
                        type="button"
                        @onclick="@(() => Nav.NavigateTo("/workoutplans"))">
                    Cancel
                </button>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public int Id { get; set; }

    private WorkoutPlan? plan;
    private bool isLoading = true;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;

        plan = await Db.WorkoutPlan.FirstOrDefaultAsync(x => x.Id == Id);
        if (plan == null)
            error = "Workout plan not found.";

        isLoading = false;
    }

    private async Task ConfirmDelete()
    {
        if (plan is null) return;

        // Remove join table rows first (avoid FK constraint issues)
        var links = await Db.WorkoutPlanExercise
            .Where(x => x.WorkoutPlanId == plan.Id)
            .ToListAsync();

        if (links.Any())
            Db.WorkoutPlanExercise.RemoveRange(links);

        Db.WorkoutPlan.Remove(plan);
        await Db.SaveChangesAsync();

        Nav.NavigateTo("/workoutplans");
    }

    private static string Safe(string? v, string fallback) =>
        string.IsNullOrWhiteSpace(v) ? fallback : v;
}
