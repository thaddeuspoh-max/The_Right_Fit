@page "/workoutplans/delete/{Id:int}"
@using Microsoft.EntityFrameworkCore
@using The_Right_Fit.Data
@using The_Right_Fit.Domain
@inject The_Right_FitContext Db
@inject NavigationManager Nav

<PageTitle>Delete Workout Plan</PageTitle>

<div class="wp">
    <div class="wp-head">
        <div>
            <h1 class="wp-title">Delete Plan</h1>
            <div class="wp-sub">This action cannot be undone.</div>
        </div>

        <NavLink class="wp-newbtn" href="/workoutplans">Back</NavLink>
    </div>

    @if (plan == null)
    {
        <div class="wp-loading">Loading…</div>
    }
    else
    {
        <div class="wp-card" style="padding:18px;">
            <div class="wp-name" style="margin:0;">@Safe(plan.PlanName, "Untitled Plan")</div>

            <div class="wp-desc" style="min-height:auto;">
                <div><strong>Goal:</strong> @Safe(plan.GoalType, "—")</div>
                <div><strong>Difficulty:</strong> @Safe(plan.DifficultyLevel, "—")</div>
                <div><strong>Duration:</strong> @plan.DurationWeeks weeks</div>
            </div>

            <div style="display:flex; gap:10px; margin-top:16px;">
                <button class="wp-newbtn"
                        style="background:#ef4444; border-color:#ef4444;"
                        @onclick="ConfirmDelete">
                    Delete
                </button>

                <button class="wp-newbtn"
                        style="background:rgba(15,23,42,.06); color:#0f172a; border-color:rgba(15,23,42,.10);"
                        @onclick="@(() => Nav.NavigateTo("/workoutplans"))">
                    Cancel
                </button>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public int Id { get; set; }
    private WorkoutPlan? plan;

    protected override async Task OnInitializedAsync()
    {
        plan = await Db.WorkoutPlan.FirstOrDefaultAsync(x => x.Id == Id);
    }

    private async Task ConfirmDelete()
    {
        if (plan is null) return;

        Db.WorkoutPlan.Remove(plan);
        await Db.SaveChangesAsync();
        Nav.NavigateTo("/workoutplans");
    }

    private static string Safe(string? v, string fallback) =>
        string.IsNullOrWhiteSpace(v) ? fallback : v;
}
