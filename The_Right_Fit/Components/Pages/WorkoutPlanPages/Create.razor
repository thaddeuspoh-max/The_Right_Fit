@page "/workoutplans/create"
@using The_Right_Fit.Data
@using The_Right_Fit.Domain
@inject The_Right_FitContext Db
@inject NavigationManager Nav

<PageTitle>Create Workout Plan</PageTitle>

<div class="wp">
    <div class="wp-head">
        <div>
            <h1 class="wp-title">Create Plan</h1>
            <div class="wp-sub">Add a new workout plan to the library.</div>
        </div>

        <NavLink class="wp-newbtn" href="/workoutplans">Back</NavLink>
    </div>

    <div class="wp-card" style="padding:18px;">
        <EditForm Model="model" OnValidSubmit="Save">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="mb-3">
                <label class="wp-label">Plan Name</label>
                <InputText class="wp-select" @bind-Value="model.PlanName" />
            </div>

            <div class="mb-3">
                <label class="wp-label">Goal Type</label>
                <InputText class="wp-select" @bind-Value="model.GoalType" />
            </div>

            <div class="mb-3">
                <label class="wp-label">Difficulty Level</label>
                <InputSelect class="wp-select" @bind-Value="model.DifficultyLevel">
                    <option value="">Select</option>
                    <option>Beginner</option>
                    <option>Intermediate</option>
                    <option>Advanced</option>
                </InputSelect>
            </div>

            <div class="mb-3">
                <label class="wp-label">Duration (Weeks)</label>
                <InputNumber class="wp-select" @bind-Value="model.DurationWeeks" />
            </div>

            <div class="mb-3">
                <label class="wp-label">UserId (optional)</label>
                <InputNumber class="wp-select" @bind-Value="model.UserId" />
            </div>

           

            <button class="wp-newbtn" type="submit">Create</button>
        </EditForm>
    </div>
</div>

@code {
    private WorkoutPlan model = new()
    {
        DurationWeeks = 4
    };

    private async Task Save()
    {
        Db.WorkoutPlan.Add(model);
        await Db.SaveChangesAsync();
        Nav.NavigateTo("/workoutplans");
    }
}
