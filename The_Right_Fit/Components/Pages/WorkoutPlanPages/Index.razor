@page "/workoutplans"
@rendermode InteractiveServer

@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using The_Right_Fit.Data
@using The_Right_Fit.Domain
@inject The_Right_FitContext Db
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav

<PageTitle>Workout Plans</PageTitle>

<div class="wp">

    <!-- HEADER -->
    <div class="wp-head">
        <div>
            <h1 class="wp-title">Workout Plans</h1>
            <div class="wp-sub">Choose a plan, stay consistent, get results.</div>
        </div>

        <NavLink class="wp-newbtn" href="/workoutplans/create">
            <span class="wp-plus">+</span>
            New Plan
        </NavLink>
    </div>

    <!-- FILTERS -->
    <div class="wp-filters">
        <div class="wp-filter">
            <div class="wp-label">Difficulty</div>
            <select class="wp-select" @bind="difficulty">
                <option value="">All</option>
                <option value="Beginner">Beginner</option>
                <option value="Intermediate">Intermediate</option>
                <option value="Advanced">Advanced</option>
            </select>
        </div>

        <div class="wp-filter">
            <div class="wp-label">Duration</div>
            <select class="wp-select" @bind="weeks">
                <option value="">All</option>
                <option value="4">4 Weeks</option>
                <option value="6">6 Weeks</option>
                <option value="8">8 Weeks</option>
                <option value="12">12 Weeks</option>
            </select>
        </div>

        <div class="wp-filter">
            <div class="wp-label">Search</div>
            <div class="wp-searchbox">
                <span class="wp-searchicon">🔍</span>
                <input class="wp-input"
                       placeholder="Search by plan name..."
                       @bind="search"
                       @bind:event="oninput" />
            </div>
        </div>
    </div>

    @if (loading)
    {
        <div class="wp-loading">Loading workout plans…</div>
    }
    else if (FilteredPlans.Count == 0)
    {
        <div class="wp-empty">
            <div class="wp-empty-title">No workout plans found</div>
            <div class="wp-empty-sub">Try adjusting filters or create a new plan.</div>
        </div>
    }
    else
    {
        <div class="wp-grid">
            @foreach (var p in FilteredPlans)
            {
                var isSystemPlan = string.IsNullOrWhiteSpace(p.OwnerIdentityUserId);
                var isMyPlan = !isSystemPlan && (p.OwnerIdentityUserId == identityUserId);

                var canManage = (isAdmin && isSystemPlan) || (!isAdmin && isMyPlan);

                var isActive = (activePlanId.HasValue && activePlanId.Value == p.Id);
                var hasOtherActive = (activePlanId.HasValue && activePlanId.Value != p.Id);

                <div class="wp-card">

                    <div class="wp-cardtop">
                        <span class="wp-tag">@Safe(p.GoalType, "General")</span>
                        <span class="wp-weeks">@p.DurationWeeks Weeks</span>
                    </div>

                    <div class="wp-name">@Safe(p.PlanName, "Untitled Plan")</div>

                    <div class="wp-diff">
                        <span class="wp-diffdot @DiffClass(p.DifficultyLevel)"></span>
                        @Safe(p.DifficultyLevel, "Not set")
                    </div>

                    <div class="wp-desc">
                        @($"{Safe(p.GoalType, "Goal")} • {Safe(p.DifficultyLevel, "Level")} • {p.DurationWeeks} weeks")
                    </div>

                    <div class="wp-cardbottom">

                        <div class="wp-actions">
                            <NavLink class="wp-linkbtn" href="@($"/workoutplans/details/{p.Id}")">
                                View
                            </NavLink>

                            @if (isActive)
                            {
                                <button type="button"
                                        class="wp-newbtn"
                                        @onclick="StopActivePlan"
                                        disabled="@busy">
                                    @(busy ? "Stopping..." : "Stop Plan")
                                </button>
                            }
                            else if (hasOtherActive)
                            {
                                <button type="button"
                                        class="wp-newbtn"
                                        disabled
                                        title="Stop your active plan first">
                                    Stop plan before starting another
                                </button>
                            }
                            else
                            {
                                <NavLink class="wp-newbtn" href="@($"/dashboard?planId={p.Id}")">
                                    Start Plan
                                </NavLink>
                            }
                        </div>

                        @if (canManage)
                        {
                            <div class="wp-actions" style="margin-top:10px;">
                                <NavLink class="wp-linkbtn" href="@($"/workoutplans/edit/{p.Id}")">
                                    Edit
                                </NavLink>

                                <NavLink class="wp-linkbtn wp-linkbtn-danger"
                                         href="@($"/workoutplans/delete/{p.Id}")">
                                    Delete
                                </NavLink>
                            </div>
                        }

                    </div>

                </div>
            }
        </div>
    }

</div>

@code {
    private bool loading = true;
    private bool busy = false;

    private List<WorkoutPlan> allPlans = new();

    private string? difficulty = "";
    private string? weeks = "";
    private string search = "";

    private string? identityUserId;
    private bool isAdmin;

    // active plan (to block duplicates)
    private int? activePlanId;

    protected override async Task OnInitializedAsync()
    {
        loading = true;

        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = auth.User;

        if (user.Identity?.IsAuthenticated != true)
        {
            Nav.NavigateTo("/Identity/Account/Login", true);
            return;
        }

        identityUserId = user.FindFirstValue(ClaimTypes.NameIdentifier);
        isAdmin = user.IsInRole("Administrator");

        allPlans = await Db.WorkoutPlan.AsNoTracking()
            .OrderByDescending(x => x.Id)
            .ToListAsync();

        await ReloadActivePlan();

        loading = false;
    }

    private async Task ReloadActivePlan()
    {
        activePlanId = await Db.UserActivePlan
            .AsNoTracking()
            .Where(x => x.OwnerIdentityUserId == identityUserId)
            .Select(x => (int?)x.WorkoutPlanId)
            .FirstOrDefaultAsync();
    }

    private async Task StopActivePlan()
    {
        if (busy) return;
        if (string.IsNullOrWhiteSpace(identityUserId)) return;

        busy = true;

        try
        {
            var row = await Db.UserActivePlan
                .FirstOrDefaultAsync(x => x.OwnerIdentityUserId == identityUserId);

            if (row is not null)
            {
                Db.UserActivePlan.Remove(row);
                await Db.SaveChangesAsync();
            }

            await ReloadActivePlan();
        }
        finally
        {
            busy = false;
        }
    }

    private List<WorkoutPlan> FilteredPlans
    {
        get
        {
            IEnumerable<WorkoutPlan> q = allPlans;

            if (isAdmin)
            {
                q = q.Where(x => string.IsNullOrWhiteSpace(x.OwnerIdentityUserId));
            }
            else
            {
                q = q.Where(x =>
                    string.IsNullOrWhiteSpace(x.OwnerIdentityUserId) ||
                    x.OwnerIdentityUserId == identityUserId
                );
            }

            if (!string.IsNullOrWhiteSpace(difficulty))
            {
                var d = difficulty.Trim();
                q = q.Where(x => (x.DifficultyLevel ?? "").Trim()
                    .Equals(d, StringComparison.OrdinalIgnoreCase));
            }

            if (!string.IsNullOrWhiteSpace(weeks) && int.TryParse(weeks, out var w))
            {
                q = q.Where(x => x.DurationWeeks == w);
            }

            if (!string.IsNullOrWhiteSpace(search))
            {
                var s = search.Trim();
                q = q.Where(x =>
                    (x.PlanName ?? "").Contains(s, StringComparison.OrdinalIgnoreCase) ||
                    (x.GoalType ?? "").Contains(s, StringComparison.OrdinalIgnoreCase) ||
                    (x.DifficultyLevel ?? "").Contains(s, StringComparison.OrdinalIgnoreCase)
                );
            }

            return q.ToList();
        }
    }

    private static string Safe(string? v, string fallback)
        => string.IsNullOrWhiteSpace(v) ? fallback : v;

    private static string DiffClass(string? d) => d?.Trim() switch
    {
        "Beginner" => "beginner",
        "Intermediate" => "intermediate",
        "Advanced" => "advanced",
        _ => ""
    };
}
