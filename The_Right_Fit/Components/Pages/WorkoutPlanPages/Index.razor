@page "/workoutplans"
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.QuickGrid
@using The_Right_Fit.Domain
@using The_Right_Fit.Data
@implements IAsyncDisposable
@inject IDbContextFactory<The_Right_Fit.Data.The_Right_FitContext> DbFactory

<PageTitle>Index</PageTitle>

<h1>Index</h1>

<p>
    <a href="workoutplans/create">Create New</a>
</p>

<QuickGrid Class="table" Items="context.WorkoutPlan">
    <PropertyColumn Property="workoutplan => workoutplan.UserId" />
    <PropertyColumn Property="workoutplan => workoutplan.TrainerId" />
    <PropertyColumn Property="workoutplan => workoutplan.PlanName" />
    <PropertyColumn Property="workoutplan => workoutplan.GoalType" />
    <PropertyColumn Property="workoutplan => workoutplan.DifficultyLevel" />
    <PropertyColumn Property="workoutplan => workoutplan.DurationWeeks" />
    <PropertyColumn Property="workoutplan => workoutplan.DateCreated" />
    <PropertyColumn Property="workoutplan => workoutplan.DateUpdated" />
    <PropertyColumn Property="workoutplan => workoutplan.CreatedBy" />
    <PropertyColumn Property="workoutplan => workoutplan.UpdatedBy" />

    <TemplateColumn Context="workoutplan">
        <a href="@($"workoutplans/edit?id={workoutplan.Id}")">Edit</a> |
        <a href="@($"workoutplans/details?id={workoutplan.Id}")">Details</a> |
        <a href="@($"workoutplans/delete?id={workoutplan.Id}")">Delete</a>
    </TemplateColumn>
</QuickGrid>

@code {
    private The_Right_FitContext context = default!;

    protected override void OnInitialized()
    {
        context = DbFactory.CreateDbContext();
    }

    public async ValueTask DisposeAsync() => await context.DisposeAsync();
}
