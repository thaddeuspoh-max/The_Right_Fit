@page "/workoutplans/details/{Id:int}"
@using Microsoft.EntityFrameworkCore
@using The_Right_Fit.Data
@using The_Right_Fit.Domain
@inject The_Right_FitContext Db
@inject NavigationManager Nav

<PageTitle>Workout Plan Details</PageTitle>

<div class="wp">
    <div class="wp-head">
        <div>
            <h1 class="wp-title">Plan Details</h1>
            <div class="wp-sub">Full details of the selected plan.</div>
        </div>

        <div style="display:flex; gap:10px;">
            <NavLink class="wp-newbtn" href="/workoutplans">Back</NavLink>
            <NavLink class="wp-newbtn" href="@($"/workoutplans/edit/{Id}")">Edit</NavLink>
        </div>
    </div>

    @if (plan == null)
    {
        <div class="wp-loading">Loading…</div>
    }
    else
    {
        <div class="wp-card" style="padding:18px;">
            <div class="wp-cardtop">
                <span class="wp-tag">@Safe(plan.GoalType, "General")</span>
                <span class="wp-weeks">@plan.DurationWeeks weeks</span>
            </div>

            <div class="wp-name">@Safe(plan.PlanName, "Untitled Plan")</div>

            <div class="wp-diff">
                <span class="wp-diffdot @DiffClass(plan.DifficultyLevel)"></span>
                @Safe(plan.DifficultyLevel, "Not set")
            </div>

            <div class="wp-desc" style="min-height:auto;">
                <strong>UserId:</strong> @(plan.UserId?.ToString() ?? "—")<br />
                <strong>TrainerId:</strong> @(plan.TrainerId?.ToString() ?? "—")
            </div>

            <div class="wp-cardbottom">
                <div class="wp-actions">
                    <NavLink class="wp-act" href="@($"/workoutplans/edit/{plan.Id}")">Edit</NavLink>
                    <NavLink class="wp-act" href="@($"/workoutplans/delete/{plan.Id}")">Delete</NavLink>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public int Id { get; set; }
    private WorkoutPlan? plan;

    protected override async Task OnInitializedAsync()
    {
        plan = await Db.WorkoutPlan.AsNoTracking().FirstOrDefaultAsync(x => x.Id == Id);
    }

    private static string Safe(string? v, string fallback) =>
        string.IsNullOrWhiteSpace(v) ? fallback : v;

    private string DiffClass(string? d) => d switch
    {
        "Beginner" => "beginner",
        "Intermediate" => "intermediate",
        "Advanced" => "advanced",
        _ => ""
    };
}
