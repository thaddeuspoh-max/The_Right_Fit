@page "/workoutplans/details/{Id:int}"
@rendermode InteractiveServer

@using Microsoft.EntityFrameworkCore
@using The_Right_Fit.Data
@using The_Right_Fit.Domain
@inject The_Right_FitContext Db
@inject NavigationManager Nav

<PageTitle>Workout Plan Details</PageTitle>

<div class="wp">
    <!-- HEADER -->
    <div class="wp-head">
        <div>
            <h1 class="wp-title">Plan Details</h1>
            <div class="wp-sub">Full details of the selected workout plan.</div>
        </div>

        <div style="display:flex; gap:10px;">
            <NavLink class="wp-newbtn" href="/workoutplans">Back</NavLink>
        </div>
    </div>

    @if (plan is null)
    {
        <div class="wp-loading">Loading…</div>
    }
    else
    {
        <!-- PLAN CARD -->
        <div class="wp-card">
            <div class="wp-cardpad">
                <div class="wp-cardtop">
                    <span class="wp-tag">@Safe(plan.GoalType, "General")</span>
                    <span class="wp-weeks">@plan.DurationWeeks weeks</span>
                </div>

                <div class="wp-name">@Safe(plan.PlanName, "Untitled Plan")</div>

                <div class="wp-diff">
                    <span class="wp-diffdot @DiffClass(plan.DifficultyLevel)"></span>
                    @Safe(plan.DifficultyLevel, "Not set")
                </div>

                <div class="wp-kv">
                    <div class="wp-k">Goal Type</div>
                    <div class="wp-v">@Safe(plan.GoalType, "—")</div>

                    <div class="wp-k">Difficulty</div>
                    <div class="wp-v">@Safe(plan.DifficultyLevel, "—")</div>

                    <div class="wp-k">Duration</div>
                    <div class="wp-v">@plan.DurationWeeks weeks</div>

                    <div class="wp-k">Created By</div>
                    <div class="wp-v">@creatorLabel</div>
                </div>
            </div>

            <!-- ✅ Removed Edit/Delete buttons -->
        </div>

        <!-- EXERCISES CARD -->
        <div class="wp-card">
            <div class="wp-cardpad">
                <div class="wp-sectionhead">
                    <h2 class="wp-sectiontitle">Exercises</h2>
                </div>

                @if (planExercises.Count == 0)
                {
                    <div class="wp-empty">
                        <div class="wp-empty-title">No exercises added</div>
                        <div class="wp-empty-sub">
                            This workout plan does not have any exercises yet.
                        </div>
                    </div>
                }
                else
                {
                    @foreach (var dayGroup in planExercises
                                .GroupBy(x => x.DayOfWeek)
                                .OrderBy(g => g.Key))
                    {
                        <div class="wp-day">
                            <h3 class="wp-daytitle">@DayName(dayGroup.Key)</h3>

                            <div class="wp-tablewrap">
                                <table class="wp-table">
                                    <thead>
                                        <tr>
                                            <th>Exercise</th>
                                            <th>Sets</th>
                                            <th>Reps</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var row in dayGroup)
                                        {
                                            <tr>
                                                <td>@row.ExerciseName</td>
                                                <td>@row.Sets</td>
                                                <td>@row.Reps</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public int Id { get; set; }

    private WorkoutPlan? plan;
    private List<PlanExerciseRow> planExercises = new();

    // creator display
    private string creatorLabel = "—";

    protected override async Task OnInitializedAsync()
    {
        plan = await Db.WorkoutPlan
            .AsNoTracking()
            .FirstOrDefaultAsync(x => x.Id == Id);

        if (plan is null)
        {
            Nav.NavigateTo("/workoutplans");
            return;
        }

        // ✅ Creator label:
        // If OwnerIdentityUserId exists => show that user's email (or username if you prefer)
        // Else => seeded/library plan
        if (!string.IsNullOrWhiteSpace(plan.OwnerIdentityUserId))
        {
            // This works ONLY if your context has DbSet<The_Right_FitUser> (usually IdentityDbContext does)
            // If your DbSet name is different, change Db.Users to Db.Set<The_Right_FitUser>()
            var user = await Db.Set<The_Right_FitUser>()
                .AsNoTracking()
                .FirstOrDefaultAsync(u => u.Id == plan.OwnerIdentityUserId);

            creatorLabel = user?.Email
                ?? user?.UserName
                ?? plan.OwnerIdentityUserId; // fallback
        }
        else
        {
            creatorLabel = "Library / Admin (seeded)";
        }

        // Load exercises via join table
        planExercises = await Db.WorkoutPlanExercise
            .AsNoTracking()
            .Where(wpe => wpe.WorkoutPlanId == Id)
            .Join(
                Db.Exercise.AsNoTracking(),
                wpe => wpe.ExerciseId,
                ex => ex.Id,
                (wpe, ex) => new PlanExerciseRow
                {
                    DayOfWeek = wpe.DayOfWeek,
                    ExerciseName = ex.ExerciseName,
                    Sets = wpe.Sets,
                    Reps = wpe.Reps
                }
            )
            .ToListAsync();
    }

    private class PlanExerciseRow
    {
        public int DayOfWeek { get; set; }
        public string ExerciseName { get; set; } = "";
        public int Sets { get; set; }
        public int Reps { get; set; }
    }

    private static string DayName(int d) => d switch
    {
        1 => "Monday",
        2 => "Tuesday",
        3 => "Wednesday",
        4 => "Thursday",
        5 => "Friday",
        6 => "Saturday",
        7 => "Sunday",
        _ => $"Day {d}"
    };

    private static string Safe(string? v, string fallback) =>
        string.IsNullOrWhiteSpace(v) ? fallback : v;

    private string DiffClass(string? d) => d switch
    {
        "Beginner" => "beginner",
        "Intermediate" => "intermediate",
        "Advanced" => "advanced",
        _ => ""
    };
}
