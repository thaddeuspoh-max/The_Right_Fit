@inherits LayoutComponentBase
@layout AccountLayout

<div class="wp">

    <!-- HEADER -->
    <div class="wp-head">
        <div>
            <h1 class="wp-title">Settings</h1>
            <div class="wp-sub">Change your account settings.</div>
        </div>

        <a class="wp-newbtn wp-btn-secondary wp-text-black" href="/dashboard">
            Back
        </a>
    </div>

    <!-- CONTENT GRID -->
    <div class="acc-grid">

        <!-- SIDEBAR -->
        <aside class="wp-card acc-side">
            <div class="acc-sidehead">Manage</div>
            <div class="acc-nav">
                <ManageNavMenu />
            </div>
        </aside>

        <!-- PAGE CONTENT -->
        <main class="wp-card acc-main">
            <div class="acc-body">
                @Body
            </div>
        </main>

    </div>
</div>
